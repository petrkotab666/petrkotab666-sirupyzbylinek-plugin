---
import BaseLayout from './BaseLayout.astro';
import ArticleImage from '../components/ArticleImage.astro';
import ContextAds from '../components/ContextAds.astro';
import ProductFeed from '../components/ProductFeed.astro';
import {
  articleUrl,
  cleanDescription,
  isMonetizable,
  topicLabel,
  type ArticleEntry,
} from '../lib/articles';
import { displayArticleImage } from '../lib/display-image';
import { articleSafetyWarnings } from '../lib/safety';
import { criticalRecipeNotice } from '../lib/critical-safety';

interface Props { entry: ArticleEntry }
const { entry } = Astro.props;
const { title, date, updated } = entry.data;
const category = topicLabel(entry);
const description = cleanDescription(entry.data.description, entry.body);
const image = displayArticleImage(entry);
const canonicalUrl = articleUrl(entry, Astro.site || Astro.url.origin);
const imageUrl = new URL(image, Astro.site || Astro.url.origin).href;
const monetizable = isMonetizable(entry);
const safetyWarnings = articleSafetyWarnings(entry);
const criticalNotice = criticalRecipeNotice(entry);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: [imageUrl],
  mainEntityOfPage: canonicalUrl,
  datePublished: date?.toISOString(),
  dateModified: (updated || date)?.toISOString(),
  articleSection: category,
  inLanguage: 'cs-CZ',
  author: { '@type': 'Organization', name: 'Redakce Sirupy z bylinek', url: new URL('/', Astro.site || Astro.url.origin).href },
  publisher: {
    '@type': 'Organization',
    name: 'Sirupy z bylinek',
    url: new URL('/', Astro.site || Astro.url.origin).href,
    logo: { '@type': 'ImageObject', url: new URL('/media/imported/prirodni-repelenty-proti-komarum-a-klistatum/sirupyzbylineklogo1-1-53a25adc.png', Astro.site || Astro.url.origin).href },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Domů', item: new URL('/', Astro.site || Astro.url.origin).href },
    { '@type': 'ListItem', position: 2, name: 'Magazín', item: new URL('/magazin/', Astro.site || Astro.url.origin).href },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
  ],
};
---
<BaseLayout
  title={`${title} | Sirupy z bylinek`}
  description={description}
  image={image}
  canonical={entry.data.path}
  type="article"
  published={date}
  modified={updated || date}
  structuredData={[articleSchema, breadcrumbSchema]}
>
  <article class:list={["article-shell", { "has-hero-image": Boolean(image) }]}>
    <header class="article-header">
      <div class="article-kicker">{category}</div>
      <h1>{title}</h1>
      {description && <p class="article-lead">{description}</p>}
      <div class="article-meta">
        {date && <time datetime={date.toISOString()}>Publikováno {date.toLocaleDateString('cs-CZ')}</time>}
        {updated && <time datetime={updated.toISOString()}>Aktualizováno {updated.toLocaleDateString('cs-CZ')}</time>}
      </div>
      <ArticleImage entry={entry} class="hero-image" loading="eager" fetchpriority="high" />
    </header>

    {monetizable && <ContextAds entry={entry} placement="primary" />}

    {criticalNotice ? (
      <section class="critical-recipe-notice" aria-labelledby="critical-recipe-title">
        <span>Bezpečnostní oprava receptu</span>
        <h2 id="critical-recipe-title">{criticalNotice.title}</h2>
        <p>{criticalNotice.explanation}</p>
        <div class="critical-recipe-links">
          {criticalNotice.alternatives.map((alternative) => <a href={alternative.href}>{alternative.label} <b aria-hidden="true">→</b></a>)}
        </div>
      </section>
    ) : (
      <>
        {safetyWarnings.length > 0 && (
          <aside class="safety-box safety-box--specific">
            <strong>Důležité upozornění k této bylince</strong>
            <ul>{safetyWarnings.map((warning) => <li>{warning}</li>)}</ul>
          </aside>
        )}
        <div class="article-content"><slot /></div>
      </>
    )}

    {monetizable && <ContextAds entry={entry} placement="secondary" heading="Další doporučené nabídky k tématu" />}
    {monetizable && <ProductFeed entry={entry} />}

    <aside class="safety-box">
      <strong>Bezpečnost na prvním místě</strong>
      <p>Bylinky mohou ovlivňovat léky a nejsou vhodné pro každého. Zvláštní opatrnost je nutná u dětí, těhotných a kojících žen, chronicky nemocných a zvířat.</p>
    </aside>
  </article>

  <script is:inline>
    document.querySelectorAll('.article-shell').forEach((article) => {
      const hero = article.querySelector('.hero-image');
      if (!(hero instanceof HTMLImageElement)) return;

      let heroPath = '';
      try {
        heroPath = new URL(hero.currentSrc || hero.src, window.location.href).pathname;
      } catch {
        return;
      }

      article.querySelectorAll('.article-content img').forEach((image) => {
        if (!(image instanceof HTMLImageElement)) return;
        let contentPath = '';
        try {
          contentPath = new URL(image.currentSrc || image.src, window.location.href).pathname;
        } catch {
          return;
        }
        if (contentPath !== heroPath) return;

        const wrapper = image.closest('figure, p');
        const duplicate = wrapper || image;
        duplicate.setAttribute('hidden', '');
        duplicate.setAttribute('aria-hidden', 'true');
        duplicate.setAttribute('data-duplicate-hero', 'true');
      });
    });
  </script>
</BaseLayout>

<style is:global>
  .has-hero-image .article-content > p:first-child:has(> img:only-child),
  .has-hero-image .article-content > p:first-child:has(> a:only-child > img:only-child),
  .article-content [data-duplicate-hero="true"] {
    display: none !important;
  }
  .safety-box--specific ul{margin:.75rem 0 0;padding-left:1.2rem}
  .safety-box--specific li+li{margin-top:.45rem}
  .critical-recipe-notice{margin:2rem 0;padding:clamp(1.5rem,4vw,2.5rem);border:2px solid #b65c3a;border-radius:24px;background:linear-gradient(135deg,#fff3df,#f7e0c4);box-shadow:0 18px 40px rgba(91,45,25,.12);text-align:center}
  .critical-recipe-notice>span{font-size:.78rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:#a14327}
  .critical-recipe-notice h2{margin:.55rem auto .85rem;max-width:760px;color:#5a291d}
  .critical-recipe-notice p{max-width:820px;margin:0 auto;color:#5b483f;line-height:1.75}
  .critical-recipe-links{display:flex;flex-wrap:wrap;justify-content:center;gap:.75rem;margin-top:1.25rem}
  .critical-recipe-links a{display:inline-flex;align-items:center;gap:.35rem;padding:.75rem 1rem;border-radius:999px;background:#174c2b;color:#fff;text-decoration:none;font-weight:800}
</style>
