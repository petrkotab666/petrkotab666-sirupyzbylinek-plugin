---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/modules.css';
import '../styles/unified-media.css';
import '../styles/visual-refresh.css';
import '../styles/hub-navigation.css';
import '../styles/original-assets-recovery.css';
import '../styles/final-responsive-fixes.css';

const {
  title = 'Sirupy z bylinek – recepty, sběr a přírodní inspirace',
  description = 'Praktický průvodce bylinkami, domácími sirupy, tinkturami, čaji, limonádami a bezpečným sběrem.',
  image = '/obrazky/bylinky.svg',
  canonical,
  type = 'website',
  published,
  modified,
  prev,
  next,
  noindex = false,
  structuredData = [],
} = Astro.props;

const siteUrl = Astro.site || new URL(Astro.url.origin);
const canonicalUrl = canonical ? new URL(canonical, siteUrl) : new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
const normalizedDescription = String(description || '').replace(/\s+/gu, ' ').trim();
const metaDescription = normalizedDescription.length >= 60
  ? normalizedDescription
  : `${normalizedDescription}${normalizedDescription ? ' ' : ''}Přesný postup, praktické použití, skladování a bezpečnostní upozornění na jednom místě.`;
const schemas = Array.isArray(structuredData) ? structuredData : [structuredData];
const commonSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Sirupy z bylinek',
    url: new URL('/', siteUrl).href,
    logo: new URL('/media/imported/prirodni-repelenty-proti-komarum-a-klistatum/sirupyzbylineklogo1-1-53a25adc.png', siteUrl).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Sirupy z bylinek',
    url: new URL('/', siteUrl).href,
    inLanguage: 'cs-CZ',
    description: 'Praktické recepty, sběr, pěstování a bezpečné používání bylinek.',
  },
];
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:large'} />
    <link rel="canonical" href={canonicalUrl} />
    {prev && <link rel="prev" href={new URL(prev, siteUrl)} />}
    {next && <link rel="next" href={new URL(next, siteUrl)} />}
    <link rel="alternate" type="application/rss+xml" title="Sirupy z bylinek" href="/rss.xml" />

    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Sirupy z bylinek" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content={title} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#174e29" />
    <link rel="icon" href="/media/imported/prirodni-repelenty-proti-komarum-a-klistatum/sirupyzbylineklogo1-1-53a25adc.png" />

    {[...commonSchemas, ...schemas].filter(Boolean).map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#obsah">Přejít k obsahu</a>
    <Header />
    <main id="obsah"><slot /></main>
    <Footer />
  </body>
</html>
