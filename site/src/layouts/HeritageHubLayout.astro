---
import BaseLayout from './BaseLayout.astro';
import ContextAds from '../components/ContextAds.astro';
import ProductFeed from '../components/ProductFeed.astro';
import { hubPhotoAlt, resolveHubImage, uniqueHubPhoto } from '../lib/hub-photo';

interface HubCard {
  href: string;
  title: string;
  text: string;
  image: string;
  imageAlt?: string;
  kicker?: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  eyebrow: string;
  heading: string;
  intro: string;
  heroImage: string;
  heroAlt: string;
  cards: HubCard[];
  directoryTitle?: string;
  directoryText?: string;
  adTopic?: string;
  adHeading?: string;
  feedTopic?: string;
  feedHeading?: string;
}

const {
  title,
  description,
  canonical,
  eyebrow,
  heading,
  intro,
  heroImage,
  heroAlt,
  cards,
  directoryTitle = 'Vyberte si další cestu',
  directoryText = 'Každá karta vede na samostatný přehled nebo praktický návod.',
  adTopic = 'bylinky',
  adHeading = 'Co se může hodit k tomuto tématu',
  feedTopic = adTopic,
  feedHeading = 'Doporučené pomůcky, knihy a suroviny',
} = Astro.props;

const imageKey = (src = '') => src.split(/[?#]/u)[0] || '';
const requestedHeroKey = imageKey(heroImage);
const resolvedHeroImage = resolveHubImage(heroImage, canonical, heading, 0, `${canonical}#hero`);
const heroImageKey = imageKey(resolvedHeroImage);
const heroResolvedFromExplicitRaster = Boolean(requestedHeroKey && requestedHeroKey === heroImageKey);
const usedImageKeys = new Set<string>([heroImageKey]);
const resolvedCards = cards.map((card, index) => {
  let image = resolveHubImage(card.image, card.href, card.title, index, canonical);
  let key = imageKey(image);
  const requestedKey = imageKey(card.image);
  const resolvedFromExplicitRaster = Boolean(requestedKey && requestedKey === key);

  // Tvrdě blokujeme jen skutečnou chybu dat: hero i karta mají výslovně
  // zadaný stejný rastrový soubor. Pokud hero vzniklo automaticky ze SVG,
  // necháme existující deduplikační fallback vybrat unikátní kartu.
  if (heroResolvedFromExplicitRaster && resolvedFromExplicitRaster && key === heroImageKey) {
    throw new Error(`Rozcestník ${canonical} používá stejný explicitní obrázek pro hero i kartu ${card.title}: ${key}. Zvolte pro kartu vlastní obrázek.`);
  }

  if (!key || usedImageKeys.has(key)) {
    const usedForResolver = new Set<string>(usedImageKeys);
    image = uniqueHubPhoto(usedForResolver, card.href, card.title, index, canonical);
    key = imageKey(image);

    // uniqueHubPhoto pracuje s plnými cestami; tato pojistka hlídá i případné
    // query/hash varianty, které se po buildu sjednotí na stejný obrázek.
    if (usedImageKeys.has(key)) {
      for (let offset = 1; offset <= 64; offset += 1) {
        const alternative = uniqueHubPhoto(usedForResolver, card.href, card.title, index + offset, `${canonical}#${offset}`);
        const alternativeKey = imageKey(alternative);
        if (!usedImageKeys.has(alternativeKey)) {
          image = alternative;
          key = alternativeKey;
          break;
        }
        usedForResolver.add(alternative);
      }
    }
  }

  if (usedImageKeys.has(key)) {
    throw new Error(`Rozcestník ${canonical} stále opakuje fotografii ${key} u karty ${card.title}.`);
  }

  usedImageKeys.add(key);
  return {
    ...card,
    image,
    imageAlt: card.imageAlt || hubPhotoAlt(card.title),
  };
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: heading,
  description,
  url: new URL(canonical, Astro.site || Astro.url.origin).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: resolvedCards.length,
    itemListElement: resolvedCards.map((card, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: card.title,
      url: new URL(card.href, Astro.site || Astro.url.origin).href,
    })),
  },
};
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={resolvedHeroImage}
  structuredData={[schema]}
>
  <header class="heritage-hub-hero">
    <img src={resolvedHeroImage} alt={heroAlt || hubPhotoAlt(heading)} width="1200" height="675" loading="eager" fetchpriority="high" decoding="async" />
    <div class="heritage-hub-hero__shade" aria-hidden="true"></div>
    <div class="heritage-hub-hero__copy">
      <span>{eyebrow}</span>
      <h1>{heading}</h1>
      <p>{intro}</p>
    </div>
  </header>

  <section class="heritage-directory section-wrap" aria-label={directoryTitle}>
    <div class="section-heading centered-heading">
      <span>Tematický rozcestník</span>
      <h2>{directoryTitle}</h2>
      <p>{directoryText}</p>
    </div>
    <div class="heritage-directory__grid">
      {resolvedCards.map((card) => (
        <a class="heritage-directory__card" href={card.href}>
          <span class="heritage-directory__image">
            <img src={card.image} alt={card.imageAlt || card.title} width="1200" height="675" loading="lazy" decoding="async" />
            <span aria-hidden="true"></span>
          </span>
          <span class="heritage-directory__copy">
            {card.kicker && <small>{card.kicker}</small>}
            <strong>{card.title}</strong>
            <span>{card.text}</span>
            <b>Otevřít <i aria-hidden="true">→</i></b>
          </span>
        </a>
      ))}
    </div>
  </section>

  <ContextAds topic={adTopic} heading={adHeading} />
  <slot />
  <ProductFeed topic={feedTopic} heading={feedHeading} />
</BaseLayout>

<style is:global>
  .heritage-hub-hero{position:relative;width:min(1120px,calc(100% - 2rem));min-height:470px;margin:2rem auto 0;overflow:hidden;border-radius:34px;background:#173f25;box-shadow:0 24px 60px rgba(26,61,32,.18)}
  .heritage-hub-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .heritage-hub-hero__shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(12,48,27,.05) 5%,rgba(10,42,24,.35) 45%,rgba(8,35,20,.9) 100%)}
  .heritage-hub-hero__copy{position:relative;z-index:1;display:flex;min-height:470px;flex-direction:column;align-items:center;justify-content:flex-end;padding:clamp(2rem,6vw,4.4rem);text-align:center;color:#fff}
  .heritage-hub-hero__copy>span{font-size:.78rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:#ffc55a}
  .heritage-hub-hero__copy h1{max-width:880px;margin:.65rem auto .85rem;color:#fffdf2;font-size:clamp(2.65rem,6vw,5.35rem);line-height:.98;text-wrap:balance}
  .heritage-hub-hero__copy p{max-width:820px;margin:0 auto;color:#eff5e9;font-size:clamp(1rem,2vw,1.18rem);line-height:1.7;text-wrap:pretty}
  .heritage-directory{padding-top:4rem;padding-bottom:2rem}
  .heritage-directory .section-heading{max-width:860px;margin-right:auto;margin-left:auto;text-align:center}
  .heritage-directory__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.35rem;align-items:stretch}
  .heritage-directory__card{display:flex;min-width:0;flex-direction:column;overflow:hidden;border:1px solid rgba(31,75,39,.16);border-radius:28px;background:#fffdf7;color:inherit;text-decoration:none;box-shadow:0 17px 42px rgba(30,67,36,.1);transition:transform .22s ease,box-shadow .22s ease}
  .heritage-directory__card:hover{transform:translateY(-5px);box-shadow:0 26px 55px rgba(30,67,36,.17)}
  .heritage-directory__image{position:relative;display:block;aspect-ratio:16/10;overflow:hidden;background:#e8eedb}
  .heritage-directory__image>img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}
  .heritage-directory__image>span{position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(12,48,27,.22))}
  .heritage-directory__card:hover .heritage-directory__image>img{transform:scale(1.035)}
  .heritage-directory__copy{display:flex;flex:1;flex-direction:column;align-items:center;justify-content:flex-start;padding:1.45rem 1.35rem 1.55rem;text-align:center}
  .heritage-directory__copy small{display:block;color:#b66a25;font-size:.72rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
  .heritage-directory__copy>strong{display:block;margin:.42rem auto .55rem;color:#174c2b;font:700 clamp(1.45rem,2.5vw,1.85rem)/1.15 Georgia,serif;text-wrap:balance}
  .heritage-directory__copy>span{display:block;max-width:31rem;margin:0 auto;color:#667167;line-height:1.58;text-wrap:pretty}
  .heritage-directory__copy>b{display:inline-flex;align-items:center;gap:.35rem;margin-top:auto;padding:.78rem 1.08rem 0;color:#286f39;font-size:.92rem;font-style:normal}
  .heritage-directory__copy i{font-style:normal}
  @media(max-width:900px){.heritage-directory__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:620px){.heritage-hub-hero{width:min(100% - 1rem,1120px);min-height:430px;border-radius:25px}.heritage-hub-hero__copy{min-height:430px;padding:2rem 1.15rem}.heritage-hub-hero__copy h1{font-size:2.75rem}.heritage-directory{padding-top:3rem}.heritage-directory__grid{grid-template-columns:1fr}.heritage-directory__image{aspect-ratio:16/9}}
</style>