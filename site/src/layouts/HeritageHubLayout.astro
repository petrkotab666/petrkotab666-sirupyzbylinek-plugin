---
import { getCollection, render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ContextAds from '../components/ContextAds.astro';
import ProductFeed from '../components/ProductFeed.astro';

interface HubCard {
  href: string;
  title: string;
  text: string;
  image: string;
  imageAlt?: string;
  kicker?: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  eyebrow: string;
  heading: string;
  intro: string;
  heroImage: string;
  heroAlt: string;
  cards: HubCard[];
  directoryTitle?: string;
  directoryText?: string;
  adTopic?: string;
  adHeading?: string;
  feedTopic?: string;
  feedHeading?: string;
}

const {
  title,
  description,
  canonical,
  eyebrow,
  heading,
  intro,
  heroImage,
  heroAlt,
  cards,
  directoryTitle = 'Vyberte si další cestu',
  directoryText = 'Každá karta vede na samostatný přehled nebo praktický návod.',
  adTopic = 'bylinky',
  adHeading = 'Co se může hodit k tomuto tématu',
  feedTopic = adTopic,
  feedHeading = 'Doporučené pomůcky, knihy a suroviny',
} = Astro.props;

const sourceEntries = await getCollection('articles', ({ data }) => !data.draft && data.path === canonical);
const sourceEntry = sourceEntries[0];
const OriginalContent = sourceEntry ? (await render(sourceEntry)).Content : null;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: heading,
  description,
  url: new URL(canonical, Astro.site || Astro.url.origin).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: cards.length,
    itemListElement: cards.map((card, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: card.title,
      url: new URL(card.href, Astro.site || Astro.url.origin).href,
    })),
  },
};
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={heroImage}
  structuredData={[schema]}
>
  <header class="heritage-hub-hero">
    <img src={heroImage} alt={heroAlt} width="1200" height="675" loading="eager" fetchpriority="high" decoding="async" />
    <div class="heritage-hub-hero__shade" aria-hidden="true"></div>
    <div class="heritage-hub-hero__copy">
      <span>{eyebrow}</span>
      <h1>{heading}</h1>
      <p>{intro}</p>
    </div>
  </header>

  <section class="heritage-directory section-wrap" aria-label={directoryTitle}>
    <div class="section-heading centered-heading heritage-directory__heading">
      <span>Tematický rozcestník</span>
      <h2>{directoryTitle}</h2>
      <p>{directoryText}</p>
    </div>
    <div class="heritage-directory__grid">
      {cards.map((card, index) => (
        <a class="heritage-directory__card" href={card.href}>
          <span class="heritage-directory__image">
            <img src={card.image} alt={card.imageAlt || card.title} width="1200" height="675" loading="lazy" decoding="async" />
            <span class="heritage-directory__image-shade" aria-hidden="true"></span>
            <em aria-hidden="true">{String(index + 1).padStart(2, '0')}</em>
          </span>
          <span class="heritage-directory__copy">
            {card.kicker && <small>{card.kicker}</small>}
            <strong>{card.title}</strong>
            <span>{card.text}</span>
            <b>Prozkoumat téma <i aria-hidden="true">→</i></b>
          </span>
        </a>
      ))}
    </div>
  </section>

  <ContextAds topic={adTopic} heading={adHeading} />
  {OriginalContent && (
    <section class="section-wrap heritage-original-content" data-original-imported-content={canonical}>
      <div class="article-content"><OriginalContent /></div>
    </section>
  )}
  <slot />
  <ProductFeed topic={feedTopic} heading={feedHeading} />
</BaseLayout>

<style is:global>
  .heritage-hub-hero{
    position:relative;
    width:min(1180px,calc(100% - 2rem));
    min-height:410px;
    margin:1.6rem auto 0;
    overflow:hidden;
    border:1px solid rgba(28,74,42,.14);
    border-radius:30px;
    background:#173f25;
    box-shadow:0 24px 62px rgba(26,61,32,.16);
  }
  .heritage-hub-hero>img{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    filter:saturate(.94) contrast(1.03);
  }
  .heritage-hub-hero__shade{
    position:absolute;
    inset:0;
    background:
      linear-gradient(180deg,rgba(8,36,20,.06) 8%,rgba(8,35,20,.30) 47%,rgba(6,29,16,.88) 100%),
      linear-gradient(90deg,rgba(10,39,22,.18),transparent 45%,rgba(10,39,22,.12));
  }
  .heritage-hub-hero__copy{
    position:relative;
    z-index:1;
    display:flex;
    min-height:410px;
    flex-direction:column;
    align-items:center;
    justify-content:flex-end;
    padding:clamp(2rem,5vw,3.65rem);
    text-align:center;
    color:#fff;
  }
  .heritage-hub-hero__copy>span{
    display:inline-flex;
    align-items:center;
    min-height:30px;
    padding:.42rem .76rem;
    border:1px solid rgba(255,224,158,.42);
    border-radius:999px;
    background:rgba(18,50,29,.48);
    color:#ffd487;
    font-size:.72rem;
    font-weight:900;
    letter-spacing:.14em;
    text-transform:uppercase;
    backdrop-filter:blur(8px);
  }
  .heritage-hub-hero__copy h1{
    max-width:900px;
    margin:.7rem auto .7rem;
    color:#fffdf3;
    font-size:clamp(2.5rem,5.1vw,4.6rem);
    line-height:1;
    letter-spacing:-.025em;
    text-wrap:balance;
    text-shadow:0 2px 20px rgba(0,0,0,.22);
  }
  .heritage-hub-hero__copy p{
    max-width:790px;
    margin:0 auto;
    color:#eef4e9;
    font-size:clamp(.98rem,1.7vw,1.12rem);
    line-height:1.65;
    text-wrap:pretty;
  }

  .heritage-directory{
    padding-top:3.2rem;
    padding-bottom:2.25rem;
  }
  .heritage-directory .heritage-directory__heading,
  .heritage-directory .section-heading.centered-heading{
    max-width:780px;
    margin-right:auto;
    margin-left:auto;
    text-align:center;
  }
  .heritage-directory .heritage-directory__heading>span{
    display:inline-block;
    margin-bottom:.55rem;
    color:#b96b24;
    font-size:.72rem;
    font-weight:900;
    letter-spacing:.16em;
    text-transform:uppercase;
  }
  .heritage-directory .heritage-directory__heading h2{
    margin:.1rem auto .8rem;
    color:#174528;
    font-size:clamp(2.15rem,4vw,3.45rem);
    line-height:1.04;
    letter-spacing:-.025em;
    text-wrap:balance;
  }
  .heritage-directory .heritage-directory__heading p{
    max-width:720px;
    margin:0 auto;
    color:#687269;
    font-size:1.02rem;
    line-height:1.65;
    text-wrap:pretty;
  }
  .heritage-directory__grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:1.15rem;
    align-items:stretch;
    margin-top:2.1rem;
  }
  .heritage-directory__card{
    display:grid;
    grid-template-columns:minmax(175px,.9fr) minmax(0,1.25fr);
    min-width:0;
    min-height:270px;
    overflow:hidden;
    border:1px solid rgba(31,75,39,.12);
    border-radius:24px;
    background:#fffefa;
    color:inherit;
    text-decoration:none;
    box-shadow:0 12px 34px rgba(30,67,36,.08);
    transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease;
  }
  .heritage-directory__card:hover{
    transform:translateY(-4px);
    border-color:rgba(35,103,54,.26);
    box-shadow:0 22px 48px rgba(30,67,36,.14);
  }
  .heritage-directory__card:focus-visible{
    outline:4px solid rgba(218,146,45,.55);
    outline-offset:4px;
  }
  .heritage-directory__image{
    position:relative;
    display:block;
    min-height:270px;
    overflow:hidden;
    background:#dfe8d4;
  }
  .heritage-directory__image>img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:transform .42s ease,filter .42s ease;
  }
  .heritage-directory__image-shade{
    position:absolute;
    inset:0;
    background:linear-gradient(180deg,transparent 48%,rgba(9,42,23,.44) 100%);
  }
  .heritage-directory__image>em{
    position:absolute;
    right:1rem;
    bottom:.85rem;
    z-index:2;
    color:rgba(255,255,255,.88);
    font:700 1.9rem/1 Georgia,serif;
    font-style:normal;
    letter-spacing:-.04em;
    text-shadow:0 2px 12px rgba(0,0,0,.25);
  }
  .heritage-directory__card:hover .heritage-directory__image>img{
    transform:scale(1.045);
    filter:saturate(1.05) contrast(1.02);
  }
  .heritage-directory__copy{
    display:flex;
    min-width:0;
    flex-direction:column;
    align-items:flex-start;
    justify-content:flex-start;
    padding:1.7rem 1.65rem 1.55rem;
    text-align:left;
  }
  .heritage-directory__copy small{
    display:block;
    color:#b66a25;
    font-size:.68rem;
    font-weight:900;
    letter-spacing:.14em;
    text-transform:uppercase;
  }
  .heritage-directory__copy>strong{
    display:block;
    margin:.46rem 0 .65rem;
    color:#174c2b;
    font:700 clamp(1.45rem,2.1vw,1.82rem)/1.12 Georgia,serif;
    letter-spacing:-.02em;
    text-wrap:balance;
  }
  .heritage-directory__copy>span{
    display:block;
    max-width:32rem;
    margin:0;
    color:#687169;
    font-size:.95rem;
    line-height:1.58;
    text-wrap:pretty;
  }
  .heritage-directory__copy>b{
    display:inline-flex;
    align-items:center;
    gap:.55rem;
    margin-top:auto;
    padding-top:1.15rem;
    color:#246b37;
    font-size:.89rem;
    font-style:normal;
    font-weight:850;
  }
  .heritage-directory__copy i{
    display:inline-grid;
    width:27px;
    height:27px;
    place-items:center;
    border-radius:50%;
    background:#edf4e8;
    color:#246b37;
    font-style:normal;
    transition:transform .22s ease,background .22s ease;
  }
  .heritage-directory__card:hover .heritage-directory__copy i{
    transform:translateX(3px);
    background:#e2efdc;
  }
  .heritage-original-content{padding-top:2rem;padding-bottom:2rem}

  @media(max-width:980px){
    .heritage-directory__grid{grid-template-columns:1fr}
    .heritage-directory__card{grid-template-columns:minmax(220px,.82fr) minmax(0,1.18fr)}
  }
  @media(max-width:680px){
    .heritage-hub-hero{width:min(100% - 1rem,1180px);min-height:390px;margin-top:.8rem;border-radius:22px}
    .heritage-hub-hero__copy{min-height:390px;padding:1.7rem 1.15rem 2rem}
    .heritage-hub-hero__copy h1{font-size:2.65rem}
    .heritage-directory{padding-top:2.6rem}
    .heritage-directory__grid{gap:1rem;margin-top:1.65rem}
    .heritage-directory__card{grid-template-columns:1fr;min-height:0;border-radius:21px}
    .heritage-directory__image{min-height:0;aspect-ratio:16/9}
    .heritage-directory__copy{padding:1.35rem 1.25rem 1.3rem}
    .heritage-directory__copy>b{padding-top:1rem}
  }
</style>