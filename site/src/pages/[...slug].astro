---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { isAuxiliaryPage } from '../lib/articles';

export async function getStaticPaths() {
  const reserved = new Set([
    '/magazin/',
    '/rss.xml/',
    '/404/',
    '/bylinkovy-magazin-rady-tipy-inspirace-bylinkovy-magazin/',
    '/bylinkovy-magazin/',
    '/novinky/',
    '/osvedcene-recepty/',
    '/domu/sber-bylinek/',
    '/domu/sber-bylinek/kdy-sbirat-bylinky/',
    '/domu/co-sbirat/',
    '/etika-sberu/',
    '/sber-bylinek/co-nesbirat/',
    '/kde-a-kam-sbirat-bylinky/',
    '/domu/sber-bylinek/zpracovani-bylin/',
    '/domaci-sirupy/',
    '/tinktury/',
    '/recepty-na-domaci-limonady/',
    '/sirupy-a-recepty-pro-zvirata/',
    '/domu/prirodni-lekarna/',
    '/aktualni-slevy-a-vyhodne-nabidky-pro-bylinkare/',
    '/bylinkova-herna/',
    '/bylinkove-pexeso/',
    '/poznej-bylinku/',
    '/bylinkovy-mistr/',
  ]);
  const entries = await getCollection('articles', ({ data }) =>
    !data.draft
    && data.path !== '/'
    && !reserved.has(data.path)
    && !/\/page\/\d+\/$/.test(data.path),
  );
  return entries
    .filter((entry) => !isAuxiliaryPage(entry))
    .map((entry) => ({
      params: { slug: entry.data.path.replace(/^\//, '').replace(/\/$/, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<ArticleLayout entry={entry}><Content /></ArticleLayout>
