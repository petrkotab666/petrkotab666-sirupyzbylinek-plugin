---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContextAds from '../../components/ContextAds.astro';
import ProductFeed from '../../components/ProductFeed.astro';
import SectionHero from '../../components/SectionHero.astro';
import IllustratedDirectory from '../../components/IllustratedDirectory.astro';

const games = [
  {
    href: '/bylinkove-pexeso/',
    art: 'games',
    kicker: 'Paměťová hra',
    title: 'Bylinkové pexeso',
    text: 'Otočte karty a najděte dvojice známých bylinek.',
  },
  {
    href: '/poznej-bylinku/',
    art: 'identify',
    kicker: 'Poznávačka',
    title: 'Poznej bylinku',
    text: 'Poznávejte bylinky podle vzhledu a typických znaků.',
  },
  {
    href: '/bylinkovy-mistr/',
    art: 'harvest',
    kicker: 'Arkádová hra',
    title: 'Bylinkový mistr',
    text: 'Chytejte správné ingredience, dokončujte recepty a porazte závěrečného bosse.',
  },
] as const;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Bylinková herna',
  description: 'Tři interaktivní hry o bylinkách: pexeso, poznávačka a arkádový Bylinkový mistr.',
  url: new URL('/bylinkova-herna/', Astro.site || Astro.url.origin).href,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: games.map((game, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: game.title,
      url: new URL(game.href, Astro.site || Astro.url.origin).href,
    })),
  },
};
---
<BaseLayout
  title="Bylinková herna – pexeso, poznávačka a arkáda | Sirupy z bylinek"
  description="Zahrajte si bylinkové pexeso, poznávačku bylin a arkádovou hru Bylinkový mistr."
  canonical="/bylinkova-herna/"
  image="/obrazky/bylinky.svg"
  structuredData={[schema]}
>
  <SectionHero
    eyebrow="Hry pro malé i velké bylinkáře"
    title="Bylinková herna"
    text="Paměťové pexeso, poznávačka a původní arkádová hra se sbíráním ingrediencí."
    art="games"
    theme="blue"
  />

  <section class="section-wrap">
    <div class="section-heading centered-heading">
      <span>Vyberte hru</span>
      <h2>Co si dnes zahrajete?</h2>
      <p>Hry fungují přímo v prohlížeči a není potřeba nic instalovat.</p>
    </div>
    <IllustratedDirectory items={games} />
  </section>

  <ContextAds topic="bylinky" heading="Knihy, pomůcky a bylinky pro další poznávání" />
  <ProductFeed topic="bylinky" heading="Doporučené produkty pro bylinkáře" />
</BaseLayout>
