---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import ContextAds from '../../../components/ContextAds.astro';
import ProductFeed from '../../../components/ProductFeed.astro';
import SectionHero from '../../../components/SectionHero.astro';
import IllustratedDirectory from '../../../components/IllustratedDirectory.astro';
import { getPublishedArticles, topicKey } from '../../../lib/articles';

const allArticles = await getPublishedArticles();
const healthArticles = allArticles
  .filter((entry) => ['zdravi', 'vyziva', 'krasa'].includes(topicKey(entry)))
  .slice(0, 12);

const categories = [
  { href: '/prirodni-pomocnici-pro-imunitu/', art: 'pharmacy', kicker: 'Odolnost organismu', title: 'Imunita a vitalita', text: 'Bylinky, běžná výživa a praktická prevence bez přehnaných slibů.' },
  { href: '/prirodni-pomocnici-pro-traveni-a-zazivani/', art: 'harvest', kicker: 'Každodenní pohoda', title: 'Trávení a zažívání', text: 'Přehled tradičně používaných bylin a důležitých omezení.' },
  { href: '/tinktury/', art: 'process', kicker: 'Domácí výluhy', title: 'Bylinné tinktury', text: 'Výroba, dávkování podle výrobku, skladování a bezpečnost.' },
  { href: '/nejlepsi-bylinky-na-spanek-a-uklidneni-prirodni-pomoc-pri-nespavosti-a-stresu/', art: 'timing', kicker: 'Večerní režim', title: 'Spánek a zklidnění', text: 'Bylinky, klidový režim a situace, kdy je vhodná odborná pomoc.' },
] as const;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Přírodní lékárna – bylinky, bezpečnost a praktické přehledy',
  url: new URL('/domu/prirodni-lekarna/', Astro.site || Astro.url.origin).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: healthArticles.length,
    itemListElement: healthArticles.map((entry, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: entry.data.title,
      url: new URL(entry.data.path, Astro.site || Astro.url.origin).href,
    })),
  },
};
---
<BaseLayout
  title="Přírodní lékárna – bylinky, účinky a bezpečnost | Sirupy z bylinek"
  description="Přehled tradičního využití bylin, tinktur a přírodních přípravků včetně omezení, interakcí, bezpečnosti a situací, kdy vyhledat odborníka."
  canonical="/domu/prirodni-lekarna/"
  image="/obrazky/zdravi.svg"
  structuredData={[itemListSchema]}
>
  <SectionHero
    eyebrow="Přírodní lékárna"
    title="Bylinky přehledně a bezpečně"
    text="Tradiční využití, praktické postupy, důležitá omezení a jasné upozornění, kdy domácí péče nestačí."
    art="pharmacy"
    theme="green"
  />

  <section class="section-wrap section-directory">
    <div class="section-heading centered-heading"><span>Hlavní témata</span><h2>Najděte oblast, která vás zajímá</h2><p>Každý obrazový rozcestník vede k podrobnějším článkům a návazným tématům.</p></div>
    <IllustratedDirectory items={categories} />
  </section>

  <ContextAds topic="zdravi" heading="Doporučené knihy, bylinky a doplňky" />

  <section class="section-wrap section-articles">
    <div class="section-heading"><span>Nové přehledy</span><h2>Články o bylinkách a zdraví</h2><p>Texty jsou informativní a nenahrazují lékařskou ani veterinární péči.</p></div>
    <div class="articles-grid">{healthArticles.map((entry) => <ArticleCard entry={entry} />)}</div>
  </section>

  <ProductFeed topic="zdravi" heading="Produkty související se zdravím a vitalitou" />
</BaseLayout>
