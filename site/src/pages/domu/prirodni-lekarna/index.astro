---
import HeritageHubLayout from '../../../layouts/HeritageHubLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getPublishedArticles, topicKey } from '../../../lib/articles';

const allArticles = await getPublishedArticles();
const healthArticles = allArticles
  .filter((entry) => ['zdravi', 'vyziva', 'krasa'].includes(topicKey(entry)))
  .slice(0, 12);

const cards = [
  { href: '/prirodni-pomocnici-pro-imunitu/', title: 'Imunita a vitalita', text: 'Bylinky, plody, běžná výživa a bezpečné používání bez přehnaných léčebných slibů.', image: '/obrazky/clanky/prirodni-pomocnici-pro-imunitu.svg', kicker: 'Odolnost organismu' },
  { href: '/prirodni-pomocnici-pro-traveni-a-zazivani/', title: 'Trávení a zažívání', text: 'Máta, meduňka, fenykl, kmín, hořké byliny a důležitá omezení.', image: '/obrazky/clanky/prirodni-pomocnici-pro-traveni-a-zazivani.svg', kicker: 'Každodenní pohoda' },
  { href: '/prirodni-sila-pro-dychaci-cesty-a-nachlazeni/', title: 'Dýchací cesty', text: 'Přehled tradičních bylin, domácích forem a varovných příznaků pro návštěvu lékaře.', image: '/obrazky/clanky/prirodni-sila-pro-dychaci-cesty-a-nachlazeni.svg', kicker: 'Hrdlo a průdušky' },
  { href: '/nejlepsi-bylinky-na-spanek-a-uklidneni-prirodni-pomoc-pri-nespavosti-a-stresu/', title: 'Spánek a zklidnění', text: 'Meduňka, levandule, kozlík, chmel a bezpečnost při kombinaci s léky.', image: '/obrazky/clanky/nejlepsi-bylinky-na-spanek-a-uklidneni-prirodni-pomoc-pri-nespavosti-a-stresu.svg', kicker: 'Večerní režim' },
  { href: '/nejlepsi-bylinky-na-jatra-a-zlucnik-prirodni-detox-a-regenerace-organismu/', title: 'Játra a žlučník', text: 'Ostropestřec, pampeliška, čekanka a situace, kdy domácí bylinky nestačí.', image: '/obrazky/clanky/nejlepsi-bylinky-na-jatra-a-zlucnik-prirodni-detox-a-regenerace-organismu.svg', kicker: 'Metabolismus' },
  { href: '/prirodni-pomocnici-pro-mocove-cesty/', title: 'Močové cesty a ledviny', text: 'Zlatobýl, bříza, brusinky a omezení při dlouhodobých nebo akutních potížích.', image: '/obrazky/clanky/prirodni-pomocnici-pro-mocove-cesty.svg', kicker: 'Vylučování' },
  { href: '/prirodni-pomocnici-pro-pohybovy-aparat-a-kuzi/', title: 'Pohybový aparát a kůže', text: 'Zevní a vnitřní formy, obklady, masti a jasné oddělení rizikových bylin.', image: '/obrazky/clanky/prirodni-pomocnici-pro-pohybovy-aparat-a-kuzi.svg', kicker: 'Klouby a zevní péče' },
  { href: '/nejlepsi-bylinky-pro-zeny/', title: 'Bylinky pro ženy', text: 'Kontryhel, maliník, drmkovec a další tradiční témata s důrazem na těhotenství a léky.', image: '/obrazky/clanky/nejlepsi-bylinky-pro-zeny.svg', kicker: 'Ženská témata' },
  { href: '/prirodni-repelenty-proti-komarum-a-klistatum/', title: 'Repelenty a ochrana v přírodě', text: 'Rostlinné repelenty, praktická ochrana a bezpečnost u dětí i zvířat.', image: '/obrazky/clanky/prirodni-repelenty-proti-komarum-a-klistatum.svg', kicker: 'Komáři a klíšťata' },
] as const;
---
<HeritageHubLayout
  title="Přírodní lékárna – bylinky, tradiční využití a bezpečnost"
  description="Rozšířený obrazový rozcestník Přírodní lékárny: imunita, trávení, dýchání, spánek, játra, močové cesty, pohyb, kůže a ženská témata."
  canonical="/domu/prirodni-lekarna/"
  eyebrow="Přehled bylin a omezení"
  heading="Přírodní lékárna"
  intro="Vyberte oblast, která vás zajímá. U každého tématu najdete tradiční využití, praktické formy, důležitá omezení a situace, kdy domácí péče nestačí."
  heroImage="/media/imported/prirodni-sila-pro-imunitu-a-obranyschopnost/3obr-07cd0380.png"
  heroAlt="Bylinky, sušené rostliny a domácí přírodní lékárna"
  cards={cards}
  directoryTitle="Vyberte si oblast přírodní lékárny"
  directoryText="Devět tematických cest nahrazuje zkrácený čtyřboxový rozcestník a vrací návaznost obsahu."
  adTopic="zdravi"
  adHeading="Knihy, bylinky a doplňky k tématu"
  feedTopic="zdravi"
  feedHeading="Produkty související se zdravím a vitalitou"
>
  <section class="section-wrap section-articles">
    <div class="section-heading centered-heading"><span>Další přehledy</span><h2>Články o bylinkách a zdraví</h2><p>Texty jsou informativní a nenahrazují lékařskou ani veterinární péči.</p></div>
    <div class="articles-grid">{healthArticles.map((entry) => <ArticleCard entry={entry} />)}</div>
  </section>
</HeritageHubLayout>
