---
import HeritageHubLayout from '../../../layouts/HeritageHubLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getPublishedArticles } from '../../../lib/articles';

const cards = [
  {
    href: '/domu/sber-bylinek/kdy-sbirat-bylinky/',
    title: 'Kdy sbírat',
    text: 'Kalendář sběru, denní doba, počasí a správný okamžik pro jednotlivé části rostlin.',
    image: '/media/original/sber/kdy-sbirat.webp',
    imageAlt: 'Kalendář a vhodná doba sběru léčivých bylinek',
    kicker: 'Čas a sezona',
  },
  {
    href: '/domu/co-sbirat/',
    title: 'Co sbírat',
    text: 'Květy, listy, natě, kořeny, pupeny, plody a semena podle druhu i ročního období.',
    image: '/media/generated/sber/co-sbirat.webp',
    imageAlt: 'Botanický přehled květů, listů, plodů, pupenů, semen a kořenů vhodných ke sběru',
    kicker: 'Určování rostlin',
  },
  {
    href: '/etika-sberu/',
    title: 'Etika sběru',
    text: 'Střídmost, ochrana porostu, opylovačů a pravidla ohleduplného pohybu v přírodě.',
    image: '/media/original/sber/etika-sberu.webp',
    imageAlt: 'Šetrný a etický sběr bylinek',
    kicker: 'Úcta k přírodě',
  },
  {
    href: '/sber-bylinek/co-nesbirat/',
    title: 'Co nesbírat',
    text: 'Neznámé, chráněné, toxické, poškozené nebo znečištěné rostliny a rizikové lokality.',
    image: '/media/original/sber/co-nesbirat.webp',
    imageAlt: 'Rostliny a lokality, kterým je potřeba se při sběru vyhnout',
    kicker: 'Bezpečnost',
  },
  {
    href: '/kde-a-kam-sbirat-bylinky/',
    title: 'Kde a kam sbírat',
    text: 'Čisté louky, vlastní zahrada, balkon, nevhodná místa a správné nádoby na cestu domů.',
    image: '/media/original/sber/kde-sbirat.webp',
    imageAlt: 'Čistá lokalita vhodná pro sběr léčivých rostlin',
    kicker: 'Lokalita a výbava',
  },
  {
    href: '/domu/sber-bylinek/zpracovani-bylin/',
    title: 'Zpracování bylin',
    text: 'Sušení, skladování, čerstvé uchování, sirupy, tinktury, čaje, masti a koupele.',
    image: '/media/original/sber/zpracovani-bylin.webp',
    imageAlt: 'Sušení a domácí zpracování nasbíraných bylinek',
    kicker: 'Od košíku k výrobku',
  },
] as const;

const allArticles = await getPublishedArticles();
const collectingArticles = allArticles
  .filter((entry) => /sběr|sbírat|sušit|sušen|uchovat|pěstovat/i.test(`${entry.data.title} ${entry.data.description || ''}`))
  .slice(0, 9);
---
<HeritageHubLayout
  title="Sběr bylinek – kdy, kde a jak správně sbírat"
  description="Kompletní víceúrovňový průvodce sběrem bylinek: kdy a co sbírat, etika, bezpečnost, vhodná místa, sušení a další zpracování."
  canonical="/domu/sber-bylinek/"
  eyebrow="Průvodce šetrným sběrem"
  heading="Sběr bylinek"
  intro="Sběr bylinek nás spojuje s přírodou. Vyberte si jednu ze šesti původních oblastí a pokračujte na samostatný podrobný rozcestník."
  heroImage="/media/generated/sber/co-sbirat.webp"
  heroAlt="Botanický přehled částí rostlin vhodných ke sběru"
  cards={cards}
  directoryTitle="Šest původních oblastí sběru"
  directoryText="Každý obrazový box znovu vede na vlastní stránku, ne jen na jinou část stejného dokumentu."
  adTopic="sber"
  adHeading="Výbava pro sběr, sušení a určování bylin"
  feedTopic="sber"
  feedHeading="Doporučené pomůcky a suroviny pro bylinkáře"
>
  <section class="section-wrap sber-principles">
    <div class="section-heading centered-heading">
      <span>Bezpečný a etický sběr</span>
      <h2>Základní pravidla před cestou</h2>
    </div>
    <div class="sber-principles__grid">
      <article><strong>Čistá lokalita</strong><p>Nesbírejte u silnic, železnic, skládek, průmyslu ani na chemicky ošetřovaných plochách.</p></article>
      <article><strong>Pravidlo jedné třetiny</strong><p>Vezměte jen malou část porostu a dost rostlin ponechte přírodě, opylovačům a dalšímu růstu.</p></article>
      <article><strong>Suché počasí</strong><p>Sbírejte po oschnutí rosy. Mokré byliny se snadno zapaří a hůře se bezpečně suší.</p></article>
      <article><strong>Košík nebo plátno</strong><p>Neprodyšný igelit podporuje zapaření. Použijte košík, papírový sáček nebo plátěnou tašku.</p></article>
      <article><strong>Jisté určení</strong><p>Při pochybnostech rostlinu ponechte na místě. Hra ani jediná fotografie nenahrazuje kvalitní atlas.</p></article>
      <article><strong>Rychlé zpracování</strong><p>Po návratu bylinky roztřiďte, odstraňte poškozené části a začněte je sušit nebo zpracovávat.</p></article>
    </div>
  </section>

  {collectingArticles.length > 0 && (
    <section class="section-wrap section-articles">
      <div class="section-heading centered-heading"><span>Další návody</span><h2>Články o sběru a zpracování</h2></div>
      <div class="articles-grid">{collectingArticles.map((entry, index) => <ArticleCard entry={entry} position={index} />)}</div>
    </section>
  )}
</HeritageHubLayout>

<style>
  .sber-principles{padding-top:3.2rem}
  .sber-principles__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
  .sber-principles__grid article{padding:1.35rem;border:1px solid rgba(32,76,40,.15);border-radius:22px;background:#fffdf6;text-align:center;box-shadow:0 13px 30px rgba(31,67,38,.07)}
  .sber-principles__grid strong{display:block;color:#174c2b;font:700 1.2rem Georgia,serif}
  .sber-principles__grid p{margin:.55rem 0 0;color:#657066;line-height:1.6}
  @media(max-width:850px){.sber-principles__grid{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.sber-principles__grid{grid-template-columns:1fr}}
</style>
