---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import ContextAds from '../../components/ContextAds.astro';
import ProductFeed from '../../components/ProductFeed.astro';
import SectionHero from '../../components/SectionHero.astro';
import IllustratedDirectory from '../../components/IllustratedDirectory.astro';
import { getPublishedArticles } from '../../lib/articles';

const PAGE_SIZE = 12;
const HIDDEN_PATHS = new Set([
  '/bylinkova-herna/',
  '/bylinkova-superherna/',
  '/bylinkove-pexeso/',
  '/poznej-bylinku/',
  '/bylinkovy-mistr/',
  '/aktualni-slevy-a-vyhodne-nabidky-pro-bylinkare/',
]);
const articles = (await getPublishedArticles()).filter((entry) => !HIDDEN_PATHS.has(entry.data.path));
const totalPages = Math.max(1, Math.ceil(articles.length / PAGE_SIZE));
const pageArticles = articles.slice(0, PAGE_SIZE);
const magazineSections = [
  { href: '/domu/sber-bylinek/', art: 'harvest', kicker: 'Sezóna v přírodě', title: 'Sběr a sušení', text: 'Kdy vyrazit, co sbírat a jak úrodu šetrně uchovat.' },
  { href: '/osvedcene-recepty/', art: 'recipes', kicker: 'Domácí kuchyně', title: 'Recepty a nápoje', text: 'Sirupy, čaje, limonády, tinktury a další praktické postupy.' },
  { href: '/domu/prirodni-lekarna/', art: 'pharmacy', kicker: 'Bezpečné používání', title: 'Bylinky a zdraví', text: 'Tradiční využití, omezení a důležité bezpečnostní souvislosti.' },
  { href: '/bylinkova-herna/', art: 'games', kicker: 'Zábavné poznávání', title: 'Bylinková herna', text: 'Hry a poznávačky, které pomáhají zapamatovat si známé byliny.' },
] as const;
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Bylinkový magazín',
  url: new URL('/magazin/', Astro.site || Astro.url.origin).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: articles.length,
    itemListElement: pageArticles.map((entry, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: entry.data.title,
      url: new URL(entry.data.path, Astro.site || Astro.url.origin).href,
    })),
  },
};
---
<BaseLayout
  title="Bylinkový magazín – články, recepty a návody | Sirupy z bylinek"
  description="Praktické články o bylinkách, domácích receptech, sběru, pěstování, zpracování a bezpečném používání."
  canonical="/magazin/"
  next={totalPages > 1 ? '/magazin/2/' : undefined}
  structuredData={[itemListSchema]}
>
  <SectionHero
    eyebrow="Bylinkový magazín"
    title="Články, recepty a návody"
    text="Praktické čtení o bylinkách, domácích receptech, sběru, pěstování a bezpečném používání."
    art="magazine"
    theme="purple"
  />

  <section class="section-wrap section-directory">
    <div class="section-heading centered-heading"><span>Tematické rozcestníky</span><h2>Kam chcete pokračovat?</h2></div>
    <IllustratedDirectory items={magazineSections} />
  </section>

  <ContextAds topic="bylinky" heading="Doporučené nabídky pro čtenáře magazínu" />

  <section class="section-wrap magazine-list">
    <div class="section-heading"><span>Nejnovější obsah</span><h2>Články z bylinkového světa</h2></div>
    <div class="articles-grid">{pageArticles.map((entry) => <ArticleCard entry={entry} />)}</div>
    <Pagination currentPage={1} totalPages={totalPages} />
  </section>

  <ProductFeed topic="bylinky" heading="Produkty související s bylinkami a domácí výrobou" />
</BaseLayout>
