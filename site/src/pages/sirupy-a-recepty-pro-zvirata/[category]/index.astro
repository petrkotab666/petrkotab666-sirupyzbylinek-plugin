---
import HeritageHubLayout from '../../../layouts/HeritageHubLayout.astro';
import { getPublishedArticles } from '../../../lib/articles';
import { articleHubCards, normalizeForHub } from '../../../lib/hub-cards';
import { animalRecipeHubCategories } from '../../../data/restored-hub-categories';

export function getStaticPaths() {
  return animalRecipeHubCategories.map((category) => ({ params: { category: category.slug }, props: { categorySlug: category.slug } }));
}

const category = animalRecipeHubCategories.find((item) => item.slug === Astro.props.categorySlug);
if (!category) throw new Error(`Neznámá kategorie péče pro zvířata: ${Astro.props.categorySlug}`);

const allArticles = await getPublishedArticles();
const animalPattern = /zvirat|pro-psy|pro-psa|pro-kock|slepice|kurat|drubez|pece-o-ledviny-psa/u;
const entries = allArticles.filter((entry) => {
  if (entry.data.path === `/sirupy-a-recepty-pro-zvirata/${category.slug}/`) return false;
  const haystack = normalizeForHub(`${entry.data.title} ${entry.data.path} ${entry.data.description || ''}`);
  return animalPattern.test(haystack) && category.pattern.test(haystack);
});

const isMainAnimalPharmacy = category.slug === 'prirodni-lekarna-pro-zvirata';
const featuredSafetyPaths = [
  '/co-muze-pes-jist/',
  '/co-nesmi-pes-jist/',
  '/nebezpecne-byliny-pro-psy-a-kocky/',
  '/bylinky-pro-psy/',
  '/bylinky-pro-psy-behem-horkych-letnich-dnu/',
  '/lnene-seminko-pro-psy-navod-na-gel/',
  '/jarni-ocista-u-psu-a-kocek/',
  '/jarni-linani-u-psa-jak-ho-zvladnout-prirozene-a-bez-stresu/',
  '/co-mohou-slepice-jist/',
  '/bylinky-pro-slepice/',
  '/bylinky-pro-kurata/',
  '/zdravy-chov-drubeze-lihne-bylinky-pruvodce/',
] as const;

const mainCategoryCards = animalRecipeHubCategories
  .filter((item) => item.slug !== 'prirodni-lekarna-pro-zvirata')
  .map((item) => ({
    href: `/sirupy-a-recepty-pro-zvirata/${item.slug}/`,
    title: item.title,
    text: item.description || `Přejděte na samostatný přehled: ${item.title.toLowerCase()}.`,
    image: item.image,
    imageAlt: item.title,
    kicker: 'Vyberte oblast',
  }));

const featuredSafetyEntries = featuredSafetyPaths
  .map((path) => allArticles.find((entry) => entry.data.path === path))
  .filter((entry): entry is (typeof allArticles)[number] => Boolean(entry));

const cards = isMainAnimalPharmacy
  ? [
      ...mainCategoryCards,
      ...articleHubCards(featuredSafetyEntries, 'Bezpečnost a praktická péče'),
    ]
  : articleHubCards(entries, 'Bylinky a zvířata');
---
<HeritageHubLayout
  title={`${category.title} – bezpečný přehled`}
  description={`${category.title}: obrazový rozcestník článků, receptů, omezení a situací, kdy je nutná veterinární péče.`}
  canonical={`/sirupy-a-recepty-pro-zvirata/${category.slug}/`}
  eyebrow={category.eyebrow}
  heading={category.title}
  intro="Zvířata zpracovávají rostlinné látky jinak než lidé. Domácí postup vždy přizpůsobte druhu, hmotnosti, zdravotnímu stavu a doporučení veterináře."
  heroImage={category.image}
  heroAlt={category.title}
  cards={cards}
  directoryTitle={isMainAnimalPharmacy ? 'Nejdřív vyberte oblast, potom konkrétní téma' : 'Vyberte konkrétní článek nebo recept'}
  directoryText={isMainAnimalPharmacy
    ? `Hlavní přehled vede do ${mainCategoryCards.length} tematických oblastí a doplňuje je ${featuredSafetyEntries.length} nejdůležitějšími bezpečnostními a praktickými články.`
    : `V této oblasti je propojeno ${cards.length} bezpečnostních přehledů a domácích témat.`}
  adTopic="zvirata"
  adHeading="Knihy a vybavení pro chovatele"
  feedTopic="zvirata"
  feedHeading="Produkty související s péčí o zvířata"
/>
