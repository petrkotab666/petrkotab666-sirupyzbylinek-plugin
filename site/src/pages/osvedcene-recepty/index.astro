---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ContextAds from '../../components/ContextAds.astro';
import ProductFeed from '../../components/ProductFeed.astro';
import SectionHero from '../../components/SectionHero.astro';
import IllustratedDirectory from '../../components/IllustratedDirectory.astro';
import { getPublishedArticles, topicKey } from '../../lib/articles';

const allArticles = await getPublishedArticles();
const recipes = allArticles
  .filter((entry) => ['recepty', 'napoje', 'zavarovani'].includes(topicKey(entry)))
  .slice(0, 12);

const categories = [
  { href: '/domaci-sirupy/', art: 'recipes', kicker: 'Bylinky a ovoce', title: 'Domácí sirupy', text: 'Bezové, jitrocelové, mátové, ovocné i další sirupy krok za krokem.' },
  { href: '/tinktury/', art: 'pharmacy', kicker: 'Výluhy a kapky', title: 'Bylinné tinktury', text: 'Suroviny, postupy, skladování a bezpečné používání domácích výluhů.' },
  { href: '/recepty-na-domaci-limonady/', art: 'harvest', kicker: 'Letní osvěžení', title: 'Domácí limonády', text: 'Limonády ze sirupů, bylinných výluhů, macerace i fermentace.' },
  { href: '/sklenice-na-sirupy-a-zavarovani/', art: 'process', kicker: 'Čistota a skladování', title: 'Lahve a sklenice', text: 'Jak vybrat správnou velikost, uzávěr a vybavení pro domácí výrobu.' },
] as const;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Osvědčené recepty na sirupy, tinktury a limonády',
  url: new URL('/osvedcene-recepty/', Astro.site || Astro.url.origin).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: recipes.length,
    itemListElement: recipes.map((entry, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: entry.data.title,
      url: new URL(entry.data.path, Astro.site || Astro.url.origin).href,
    })),
  },
};
---
<BaseLayout
  title="Osvědčené recepty na sirupy, tinktury a limonády | Sirupy z bylinek"
  description="Praktické recepty na domácí bylinkové sirupy, tinktury, čaje, limonády, bonbony a další výrobky včetně správného skladování."
  canonical="/osvedcene-recepty/"
  image="/obrazky/recepty.svg"
  structuredData={[itemListSchema]}
>
  <SectionHero
    eyebrow="Recepty a domácí výroba"
    title="Osvědčené recepty z bylinek"
    text="Sirupy, tinktury, limonády a další domácí výrobky přehledně, bezpečně a s praktickými postupy."
    art="recipes"
    theme="amber"
  />

  <section class="section-wrap section-directory">
    <div class="section-heading centered-heading"><span>Vyberte si oblast</span><h2>Co chcete připravit?</h2><p>Začněte hlavním rozcestníkem a pokračujte do konkrétních receptů.</p></div>
    <IllustratedDirectory items={categories} />
  </section>

  <ContextAds topic="recepty" heading="Vybavení a suroviny pro domácí recepty" />

  <section class="section-wrap section-articles">
    <div class="section-heading"><span>Nejnovější recepty</span><h2>Vyzkoušejte nové postupy</h2><p>Aktuální návody ze všech částí receptáře.</p></div>
    <div class="articles-grid">{recipes.map((entry) => <ArticleCard entry={entry} />)}</div>
  </section>

  <ProductFeed topic="recepty" heading="Produkty vhodné pro domácí výrobu" />
</BaseLayout>
