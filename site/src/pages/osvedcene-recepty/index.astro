---
import HeritageHubLayout from '../../layouts/HeritageHubLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PreparationCard from '../../components/PreparationCard.astro';
import { getPublishedArticles, topicKey } from '../../lib/articles';
import { herbalPreparations } from '../../data/herbal-preparations';

const allArticles = await getPublishedArticles();
const recipes = allArticles
  .filter((entry) => ['recepty', 'napoje', 'zavarovani'].includes(topicKey(entry)))
  .slice(0, 12);
const featuredPreparations = herbalPreparations.filter((recipe) => recipe.featured).slice(0, 6);

const cards = [
  { href: '/domaci-sirupy/', title: 'Domácí sirupy', text: 'Bylinné, květové a ovocné sirupy rozdělené do tematických podkategorií.', image: '/media/imported/medunkovy-sirup/sirupyuvod-78eb30cb.png', kicker: 'Květy, byliny a plody' },
  { href: '/tinktury/', title: 'Bylinné tinktury', text: 'Macerace, filtrace, lahvičky, bezpečnost a přehled receptů podle témat.', image: '/obrazky/clanky/tinktury.svg', kicker: 'Výluhy a kapky' },
  { href: '/recepty-na-domaci-limonady/', title: 'Domácí limonády', text: 'Ze sirupu, výluhu, čerstvého ovoce, macerace i kontrolované fermentace.', image: '/obrazky/clanky/recepty-na-domaci-limonady.svg', kicker: 'Osvěžení' },
  { href: '/bylinne-caje/', title: 'Bylinné čaje a nálevy', text: 'Jednodruhové i jemné směsi s přesnou teplotou vody, dobou louhování a omezeními.', image: '/obrazky/recepty/medunkovy-caj-pro-klidny-vecer.svg', kicker: 'Nálevy a odvary' },
  { href: '/bylinne-koupele/', title: 'Bylinné koupele', text: 'Celkové koupele, lázně na nohy, koupelové sáčky a šetrné kombinace.', image: '/obrazky/recepty/levandulovo-ovesna-koupel.svg', kicker: 'Relaxace a zevní péče' },
  { href: '/bylinne-masti-a-balzamy/', title: 'Masti a balzámy', text: 'Olejové základy, vosk, čisté kelímky a postupy určené pro zevní použití.', image: '/obrazky/recepty/mesickova-mast.svg', kicker: 'Domácí kosmetika' },
  { href: '/bylinne-oleje-a-maceraty/', title: 'Oleje a maceráty', text: 'Měsíček, levandule, heřmánek, růže, jitrocel a rozmarýn v olejových základech.', image: '/obrazky/recepty/mesickovy-olejovy-macerat.svg', kicker: 'Olejové výluhy' },
  { href: '/bylinne-octy-a-oxymely/', title: 'Octy a oxymely', text: 'Bylinkové octy, medovo-octové základy a přesné podmínky skladování.', image: '/obrazky/recepty/tymianovy-oxymel.svg', kicker: 'Ocet a med' },
  { href: '/bylinne-obklady-a-kloktadla/', title: 'Obklady a kloktadla', text: 'Zevní obklady, oplachy, bylinná pára a krátkodobé domácí použití.', image: '/obrazky/recepty/hermankovy-obklad.svg', kicker: 'Místní použití' },
  { href: '/bylinky-v-kuchyni-recepty/', title: 'Bylinky v kuchyni', text: 'Bylinkové soli, cukry, másla, pesta, medy a ledové kostky pro běžné vaření.', image: '/obrazky/recepty/univerzalni-bylinkova-sul.svg', kicker: 'Kuchyňské výrobky' },
  { href: '/sirupy-a-recepty-pro-zvirata/', title: 'Recepty pro zvířata', text: 'Samostatný bezpečnostní rozcestník pro psy, kočky a další zvířata.', image: '/obrazky/clanky/sirupy-a-recepty-pro-zvirata.svg', kicker: 'Veterinární opatrnost' },
] as const;
---
<HeritageHubLayout
  title="Osvědčené recepty z bylinek – kompletní domácí receptář"
  description="Jednotný obrazový receptář sirupů, tinktur, čajů, limonád, koupelí, mastí, olejů, octů, obkladů, kuchyňských výrobků a receptů pro zvířata."
  canonical="/osvedcene-recepty/"
  eyebrow="Recepty a domácí výroba"
  heading="Osvědčené recepty z bylinek"
  intro="Vyberte si způsob zpracování. Každá oblast vede na vlastní rozcestník a odtud ke konkrétním receptům s postupem, skladováním a upozorněním."
  heroImage="/media/imported/medunkovy-sirup/sirupyuvod-78eb30cb.png"
  heroAlt="Domácí bylinné sirupy, tinktury a další výrobky"
  cards={cards}
  directoryTitle="Co chcete z bylinek připravit"
  directoryText="Všechny starší i nově doplněné kategorie jsou sjednocené do jedné obrazové navigace."
  adTopic="recepty"
  adHeading="Vybavení a suroviny pro domácí recepty"
  feedTopic="recepty"
  feedHeading="Produkty vhodné pro domácí výrobu"
>
  {featuredPreparations.length > 0 && (
    <section class="section-wrap featured-new-recipes">
      <div class="section-heading centered-heading"><span>Doporučený začátek</span><h2>Vybrané nové recepty</h2></div>
      <div class="recipe-feature-grid">{featuredPreparations.map((recipe) => <PreparationCard recipe={recipe} />)}</div>
    </section>
  )}

  <section class="section-wrap section-articles">
    <div class="section-heading centered-heading"><span>Další recepty</span><h2>Nejnovější sirupy, nápoje a návody</h2></div>
    <div class="articles-grid">{recipes.map((entry) => <ArticleCard entry={entry} />)}</div>
  </section>
</HeritageHubLayout>

<style>
  .recipe-feature-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.15rem}
  @media(max-width:900px){.recipe-feature-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:620px){.recipe-feature-grid{grid-template-columns:1fr}}
</style>
