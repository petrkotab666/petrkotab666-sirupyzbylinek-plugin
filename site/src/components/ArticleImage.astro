---
import type { ArticleEntry } from '../lib/articles';
import { displayArticleImage } from '../lib/display-image';
import { resolveHubImage, thematicHubPhoto } from '../lib/hub-photo';

interface Props {
  entry: ArticleEntry;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decorative?: boolean;
  mode?: 'article' | 'topic';
  position?: number;
}

const {
  entry,
  class: className,
  loading = 'lazy',
  fetchpriority = 'auto',
  decorative = false,
  mode = 'article',
  position = 0,
} = Astro.props;

const group = Astro.url.pathname;
const preferred = mode === 'topic'
  ? thematicHubPhoto(entry.data.path, entry.data.title, position, group)
  : displayArticleImage(entry);
const src = resolveHubImage(preferred, entry.data.path, entry.data.title, position, group);
const fallback = thematicHubPhoto(entry.data.path, entry.data.title, position + 7, `${group}#fallback`);
const alt = decorative ? '' : entry.data.title;
const onerror = `this.onerror=null;this.src=${JSON.stringify(fallback)};this.dataset.imageKind='photo'`;
---
<img
  class={className}
  src={src}
  alt={alt}
  width="1200"
  height="675"
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  data-image-kind="photo"
  onerror={onerror}
/>
