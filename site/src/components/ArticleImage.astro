---
import type { ArticleEntry } from '../lib/articles';
import { topicImage } from '../lib/articles';
import { displayArticleImage, emergencyArticleImage } from '../lib/display-image';

interface Props {
  entry: ArticleEntry;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decorative?: boolean;
  mode?: 'article' | 'topic';
}

const {
  entry,
  class: className,
  loading = 'lazy',
  fetchpriority = 'auto',
  decorative = false,
  mode = 'article',
} = Astro.props;

const src = mode === 'topic' ? topicImage(entry) : displayArticleImage(entry);
const fallback = emergencyArticleImage(entry);
const alt = decorative ? '' : entry.data.title;
const imageKind = src.endsWith('.svg') ? 'illustration' : 'photo';
const onerror = `this.onerror=null;this.src=${JSON.stringify(fallback)};this.dataset.imageKind='illustration'`;
---
<img
  class={className}
  src={src}
  alt={alt}
  width="1200"
  height="675"
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  data-image-kind={imageKind}
  onerror={onerror}
/>
