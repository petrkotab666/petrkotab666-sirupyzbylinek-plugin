---
import { hubPhotoAlt, thematicHubPhoto } from '../lib/hub-photo';

interface Props {
  eyebrow: string;
  title: string;
  text: string;
  art: 'harvest' | 'recipes' | 'pharmacy' | 'magazine' | 'deals' | 'games' | 'timing' | 'identify' | 'ethics' | 'avoid' | 'places' | 'process';
  theme?: 'green' | 'amber' | 'purple' | 'blue';
}

const { eyebrow, title, text, theme = 'green' } = Astro.props;
const image = thematicHubPhoto(Astro.url.pathname, title, 0, `${Astro.url.pathname}#section-hero`);
---
<section class:list={['visual-section-hero', `visual-section-hero--${theme}`]}>
  <div class="visual-section-hero-copy">
    <span>{eyebrow}</span>
    <h1>{title}</h1>
    <p>{text}</p>
  </div>
  <div class="visual-section-hero-art">
    <img src={image} alt={hubPhotoAlt(title)} width="1200" height="675" loading="eager" decoding="async" />
  </div>
</section>

<style>
  .visual-section-hero-art{padding:0;overflow:hidden}
  .visual-section-hero-art img{display:block;width:100%;height:100%;min-height:390px;object-fit:cover}
  @media(max-width:760px){.visual-section-hero-art img{min-height:260px}}
</style>
