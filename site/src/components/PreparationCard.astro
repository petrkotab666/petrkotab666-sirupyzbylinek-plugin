---
import type { HerbalPreparation } from '../data/herbal-preparations';
import { preparationCategories, preparationPath } from '../data/herbal-preparations';
import { hubPhotoAlt } from '../lib/hub-photo';
import { preparationPhoto } from '../lib/preparation-photo';

interface Props { recipe: HerbalPreparation; position?: number }
const { recipe, position = 0 } = Astro.props;
const meta = preparationCategories[recipe.category];
const href = preparationPath(recipe);
const image = preparationPhoto(`${Astro.url.pathname}#preparation-cards`, position);
---
<article class="preparation-card">
  <a class="preparation-card-image" href={href} aria-label={`Otevřít recept ${recipe.title}`}>
    <img src={image} alt={hubPhotoAlt(recipe.title)} width="1200" height="675" loading="lazy" decoding="async" />
  </a>
  <div class="preparation-card-body">
    <div class="preparation-card-meta"><span>{meta.shortTitle}</span><span>{recipe.prepMinutes} min</span></div>
    <h3><a href={href}>{recipe.title}</a></h3>
    <p>{recipe.description}</p>
    <div class="preparation-card-tags">{recipe.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}</div>
    <a class="preparation-card-cta" href={href}>Zobrazit recept <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .preparation-card{display:flex;flex-direction:column;overflow:hidden;border:1px solid rgba(30,78,43,.16);border-radius:25px;background:#fffdf7;box-shadow:0 18px 42px rgba(34,66,38,.1);transition:transform .25s ease,box-shadow .25s ease}
  .preparation-card:hover{transform:translateY(-5px);box-shadow:0 24px 50px rgba(34,66,38,.16)}
  .preparation-card-image{display:block;aspect-ratio:16/9;overflow:hidden;background:#e8efcf}
  .preparation-card-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .35s ease}
  .preparation-card:hover .preparation-card-image img{transform:scale(1.035)}
  .preparation-card-body{display:flex;flex:1;flex-direction:column;padding:1.25rem 1.3rem 1.35rem;text-align:center}
  .preparation-card-meta{display:flex;justify-content:center;gap:.65rem;color:#6d704f;font-size:.76rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
  .preparation-card-meta span+span::before{content:'•';margin-right:.65rem;color:#d9952b}
  h3{margin:.65rem 0 .55rem;font-size:1.35rem;line-height:1.18}
  h3 a{color:#174c2b;text-decoration:none}
  p{margin:0 auto;color:#647064;line-height:1.55}
  .preparation-card-tags{display:flex;flex-wrap:wrap;justify-content:center;gap:.35rem;margin-top:1rem}
  .preparation-card-tags span{padding:.3rem .58rem;border-radius:999px;background:#edf3df;color:#4d6843;font-size:.75rem;font-weight:750}
  .preparation-card-cta{align-self:center;margin-top:auto;padding-top:1rem;color:#286b39;text-decoration:none;font-weight:900}
</style>
