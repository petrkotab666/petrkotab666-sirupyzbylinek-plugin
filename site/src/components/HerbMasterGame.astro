---
const questions = [
  {
    category: 'Sběr',
    question: 'Kde se bylinky nemají sbírat?',
    options: ['Na čisté louce', 'U rušné silnice', 'Na vlastní zahradě'],
    answer: 1,
    explanation: 'Rostliny u silnic mohou být znečištěné prachem, výfukovými plyny a dalšími látkami.',
  },
  {
    category: 'Poznávání',
    question: 'Co udělat, když si nejste jistí určením rostliny?',
    options: ['Ochutnat malý kousek', 'Raději ji nesbírat', 'Smíchat ji s dobře známou bylinou'],
    answer: 1,
    explanation: 'Nejasně určená rostlina do kuchyně ani domácích přípravků nepatří.',
  },
  {
    category: 'Sběr',
    question: 'Jaká nádoba je pro čerstvě nasbírané bylinky vhodnější?',
    options: ['Prodyšný košík nebo plátěná taška', 'Uzavřený igelitový sáček', 'Mokrá plastová krabice'],
    answer: 0,
    explanation: 'V prodyšné nádobě se bylinky méně zapaří a snižuje se riziko rychlého kažení.',
  },
  {
    category: 'Sušení',
    question: 'Jaké místo je obvykle vhodné pro sušení bylinek?',
    options: ['Vlhké a teplé', 'Vzdušné, suché a mimo ostré slunce', 'Uzavřené bez proudění vzduchu'],
    answer: 1,
    explanation: 'Sucho, stín a proudění vzduchu pomáhají omezit plísně a zachovat kvalitu rostlin.',
  },
  {
    category: 'Skladování',
    question: 'Co patří na štítek domácí bylinné směsi?',
    options: ['Jen barva obalu', 'Název a datum přípravy', 'Pouze jméno výrobce'],
    answer: 1,
    explanation: 'Název a datum usnadní kontrolu stáří, složení i správného použití.',
  },
  {
    category: 'Bezpečnost',
    question: 'Co udělat s plesnivou nebo zatuchlou bylinou?',
    options: ['Opláchnout ji', 'Použít ji jen do koupele', 'Vyhodit ji'],
    answer: 2,
    explanation: 'Plesnivé a zatuchlé suroviny se nepoužívají ani po opláchnutí nebo převaření.',
  },
  {
    category: 'Příroda',
    question: 'Jak se chovat k místu, kde bylinky sbíráte?',
    options: ['Vysbírat všechny rostliny', 'Nechat dostatek rostlin pro obnovu a živočichy', 'Vytrhávat vždy celé rostliny i s kořeny'],
    answer: 1,
    explanation: 'Šetrný sběr ponechává část porostu přírodě a umožňuje rostlinám další rozmnožování.',
  },
  {
    category: 'Bezpečnost',
    question: 'Kdo by měl být při používání bylin zvlášť opatrný?',
    options: ['Děti, těhotné, chronicky nemocní a lidé užívající léky', 'Jen profesionální sportovci', 'Pouze lidé, kteří bylinky pěstují'],
    answer: 0,
    explanation: 'U rizikových skupin je důležitá individuální konzultace s lékařem nebo lékárníkem.',
  },
  {
    category: 'Domácí výroba',
    question: 'Proč je lepší začít s jednoduchým jednodruhovým přípravkem?',
    options: ['Snáze poznáte vlastní reakci', 'Vždy vydrží neomezeně dlouho', 'Nemusí se označovat'],
    answer: 0,
    explanation: 'U jednoduchého složení se lépe sleduje snášenlivost i případná nežádoucí reakce.',
  },
  {
    category: 'Bezpečnost',
    question: 'Co dělat při neobvyklé nebo zhoršující se reakci?',
    options: ['Zvýšit dávku', 'Přestat přípravek používat a poradit se s odborníkem', 'Přidat další bylinu'],
    answer: 1,
    explanation: 'Pokračování nebo kombinování dalších surovin může situaci zkomplikovat.',
  },
  {
    category: 'Skladování',
    question: 'Kde se obvykle uchovávají dobře usušené bylinky?',
    options: ['V suchu, temnu a čisté uzavřené nádobě', 'Na přímém slunci', 'V otevřené nádobě vedle sporáku'],
    answer: 0,
    explanation: 'Sucho, tma a čistá nádoba omezují vlhkost, světlo, pachy a další znehodnocení.',
  },
  {
    category: 'Sběr',
    question: 'Kdy je nevhodné sbírat nadzemní části bylinek?',
    options: ['Když jsou mokré od deště nebo rosy', 'Za suchého počasí', 'Když máte čistý košík'],
    answer: 0,
    explanation: 'Mokré rostliny se snadněji zapaří a hůře se bezpečně suší.',
  },
  {
    category: 'Zvířata',
    question: 'Lze lidský bylinný recept automaticky použít pro psa nebo kočku?',
    options: ['Ano, stačí poloviční dávka', 'Ne, vhodnost musí posoudit veterinář', 'Ano, pokud přípravek dobře voní'],
    answer: 1,
    explanation: 'Zvířata mohou některé látky zpracovávat jinak než člověk a některé rostliny jsou pro ně nevhodné.',
  },
  {
    category: 'Poznávání',
    question: 'Který znak sám o sobě nestačí k bezpečnému určení byliny?',
    options: ['Pouze podobná barva květu', 'Kombinace listů, stonku, květu a stanoviště', 'Ověření ve spolehlivém atlasu'],
    answer: 0,
    explanation: 'Řada různých rostlin má podobnou barvu květu. Rozhoduje soubor více znaků.',
  },
  {
    category: 'Domácí výroba',
    question: 'Co je důležité před plněním domácího sirupu nebo výluhu?',
    options: ['Použít čisté vhodné nádoby', 'Přidat náhodnou směs koření', 'Nechat nádoby otevřené venku'],
    answer: 0,
    explanation: 'Čistota nádob a pomůcek je základ bezpečné domácí výroby.',
  },
  {
    category: 'Bezpečnost',
    question: 'Mohou bylinky ovlivňovat účinek léků?',
    options: ['Ne, nikdy', 'Ano, některé mohou s léky interagovat', 'Jen tehdy, když jsou čerstvé'],
    answer: 1,
    explanation: 'Některé byliny mohou účinek léků zesílit, oslabit nebo jinak změnit.',
  },
  {
    category: 'Příroda',
    question: 'Co dělat s chráněnou nebo vzácnou rostlinou ve volné přírodě?',
    options: ['Nesbírat ji', 'Vzít jen květ', 'Přesadit ji domů'],
    answer: 0,
    explanation: 'Chráněné a vzácné rostliny se ve volné přírodě nesbírají ani nepřesazují.',
  },
  {
    category: 'Bezpečnost',
    question: 'Nahrazují bylinky lékařskou péči při vážných nebo přetrvávajících potížích?',
    options: ['Ano, vždy', 'Ne', 'Jen o víkendu'],
    answer: 1,
    explanation: 'Bylinky mohou být doplňkem, ale nemají oddalovat potřebné vyšetření a léčbu.',
  },
];
---
<section class="herb-master" data-game="quiz" data-game-version="master-v2" aria-label="Bylinkový mistr">
  <script type="application/json" data-master-questions set:html={JSON.stringify(questions)} />

  <div class="master-start" data-start-screen>
    <div class="master-emblem" aria-hidden="true"><span>🌿</span><b>★</b></div>
    <p class="master-kicker">Vědomostní výprava</p>
    <h2>Staňte se Bylinkovým mistrem</h2>
    <p class="master-lead">Vyberte obtížnost. Otázky i pořadí odpovědí se při každé hře promíchají.</p>
    <div class="difficulty-grid" aria-label="Výběr obtížnosti">
      <button type="button" data-difficulty="6" data-label="Učedník">
        <span aria-hidden="true">🌱</span><strong>Učedník</strong><small>6 otázek</small>
      </button>
      <button type="button" data-difficulty="10" data-label="Znalec">
        <span aria-hidden="true">🌿</span><strong>Znalec</strong><small>10 otázek</small>
      </button>
      <button type="button" data-difficulty="14" data-label="Mistr">
        <span aria-hidden="true">🏆</span><strong>Mistr</strong><small>14 otázek</small>
      </button>
    </div>
    <p class="master-best">Nejlepší výsledek: <strong data-best-score>zatím žádný</strong></p>
  </div>

  <div class="master-play" data-play-screen hidden>
    <div class="master-toolbar">
      <div><span>Otázka</span><strong data-progress>1/10</strong></div>
      <div><span>Body</span><strong data-score>0</strong></div>
      <div><span>Série</span><strong data-streak>0</strong></div>
      <button type="button" data-restart>Nová hra</button>
    </div>
    <div class="master-progress" aria-hidden="true"><span data-progress-bar></span></div>
    <div class="master-question-card">
      <span class="master-category" data-category>Sběr</span>
      <h2 data-question></h2>
      <div class="master-options" data-options></div>
      <div class="master-feedback" data-feedback aria-live="polite">Vyberte jednu odpověď.</div>
      <button class="master-next" type="button" data-next hidden>Další otázka</button>
    </div>
    <p class="master-keyboard">Tip: odpověď můžete zvolit také klávesami 1, 2 nebo 3.</p>
  </div>

  <div class="master-result" data-result-screen hidden>
    <div class="result-medal" data-result-icon aria-hidden="true">🏆</div>
    <p class="master-kicker">Výprava dokončena</p>
    <h2 data-result-title>Bylinkový mistr</h2>
    <p class="result-score" data-result-score></p>
    <p data-result-text></p>
    <div class="result-actions">
      <button type="button" data-play-again>Hrát znovu</button>
      <button type="button" class="secondary" data-share>Sdílet výsledek</button>
    </div>
    <p class="share-status" data-share-status aria-live="polite"></p>
  </div>
</section>

<script is:inline>
  const shuffleMasterItems = (items) => {
    const result = [...items];
    for (let index = result.length - 1; index > 0; index -= 1) {
      const target = Math.floor(Math.random() * (index + 1));
      [result[index], result[target]] = [result[target], result[index]];
    }
    return result;
  };

  document.querySelectorAll('[data-game-version="master-v2"]').forEach((game) => {
    const questionData = JSON.parse(game.querySelector('[data-master-questions]')?.textContent || '[]');
    const startScreen = game.querySelector('[data-start-screen]');
    const playScreen = game.querySelector('[data-play-screen]');
    const resultScreen = game.querySelector('[data-result-screen]');
    const progress = game.querySelector('[data-progress]');
    const progressBar = game.querySelector('[data-progress-bar]');
    const scoreNode = game.querySelector('[data-score]');
    const streakNode = game.querySelector('[data-streak]');
    const categoryNode = game.querySelector('[data-category]');
    const questionNode = game.querySelector('[data-question]');
    const optionsNode = game.querySelector('[data-options]');
    const feedbackNode = game.querySelector('[data-feedback]');
    const nextButton = game.querySelector('[data-next]');
    const bestScoreNode = game.querySelector('[data-best-score]');
    const resultIcon = game.querySelector('[data-result-icon]');
    const resultTitle = game.querySelector('[data-result-title]');
    const resultScore = game.querySelector('[data-result-score]');
    const resultText = game.querySelector('[data-result-text]');
    const shareStatus = game.querySelector('[data-share-status]');
    const storageKey = 'bylinkovyMistrBestV2';

    let activeQuestions = [];
    let current = 0;
    let score = 0;
    let streak = 0;
    let answered = false;
    let currentDifficulty = 'Znalec';
    let lastShareText = '';

    const loadBest = () => {
      try {
        const value = Number(localStorage.getItem(storageKey) || 0);
        bestScoreNode.textContent = value > 0 ? `${value} %` : 'zatím žádný';
      } catch {
        bestScoreNode.textContent = 'zatím žádný';
      }
    };

    const saveBest = (percent) => {
      try {
        const previous = Number(localStorage.getItem(storageKey) || 0);
        if (percent > previous) localStorage.setItem(storageKey, String(percent));
      } catch {
        // Hra funguje i v prohlížeči, který místní úložiště blokuje.
      }
      loadBest();
    };

    const showScreen = (screen) => {
      startScreen.hidden = screen !== 'start';
      playScreen.hidden = screen !== 'play';
      resultScreen.hidden = screen !== 'result';
    };

    const renderQuestion = () => {
      answered = false;
      nextButton.hidden = true;
      const item = activeQuestions[current];
      const choices = shuffleMasterItems(item.options.map((text, index) => ({ text, correct: index === item.answer })));
      categoryNode.textContent = item.category;
      questionNode.textContent = item.question;
      progress.textContent = `${current + 1}/${activeQuestions.length}`;
      progressBar.style.width = `${((current + 1) / activeQuestions.length) * 100}%`;
      scoreNode.textContent = String(score);
      streakNode.textContent = String(streak);
      feedbackNode.className = 'master-feedback';
      feedbackNode.textContent = 'Vyberte jednu odpověď.';
      optionsNode.replaceChildren(...choices.map((choice, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'master-option';
        button.dataset.correct = choice.correct ? 'true' : 'false';
        button.innerHTML = `<span>${index + 1}</span><b></b>`;
        button.querySelector('b').textContent = choice.text;
        return button;
      }));
      optionsNode.querySelector('button')?.focus();
    };

    const finishGame = () => {
      const percent = Math.round((score / activeQuestions.length) * 100);
      let title = 'Bylinkový učedník';
      let icon = '🌱';
      let text = 'Základ už máte. Zkuste si hru znovu a upevněte si pravidla bezpečného bylinkaření.';
      if (percent >= 85) {
        title = 'Bylinkový mistr';
        icon = '🏆';
        text = 'Výborně. V bezpečném sběru, skladování a používání bylin se opravdu vyznáte.';
      } else if (percent >= 60) {
        title = 'Bylinkový znalec';
        icon = '🌿';
        text = 'Velmi dobrý výsledek. K titulu mistra už vám chybí jen několik detailů.';
      }
      resultIcon.textContent = icon;
      resultTitle.textContent = title;
      resultScore.textContent = `${score} z ${activeQuestions.length} správně · ${percent} %`;
      resultText.textContent = text;
      lastShareText = `V kvízu Bylinkový mistr jsem získal(a) ${score} z ${activeQuestions.length} bodů (${percent} %).`;
      saveBest(percent);
      shareStatus.textContent = '';
      showScreen('result');
      resultTitle.focus?.();
    };

    const selectAnswer = (button) => {
      if (answered || !button) return;
      answered = true;
      const item = activeQuestions[current];
      const correct = button.dataset.correct === 'true';
      optionsNode.querySelectorAll('button').forEach((option) => {
        option.disabled = true;
        if (option.dataset.correct === 'true') option.classList.add('is-correct');
      });
      if (correct) {
        score += 1;
        streak += 1;
        button.classList.add('is-correct');
        feedbackNode.classList.add('is-correct');
        feedbackNode.innerHTML = `<strong>Správně.</strong> ${item.explanation}`;
      } else {
        streak = 0;
        button.classList.add('is-wrong');
        feedbackNode.classList.add('is-wrong');
        feedbackNode.innerHTML = `<strong>Tentokrát ne.</strong> ${item.explanation}`;
      }
      scoreNode.textContent = String(score);
      streakNode.textContent = String(streak);
      nextButton.hidden = false;
      nextButton.textContent = current === activeQuestions.length - 1 ? 'Zobrazit výsledek' : 'Další otázka';
      nextButton.focus();
    };

    const startGame = (count, label) => {
      activeQuestions = shuffleMasterItems(questionData).slice(0, count);
      currentDifficulty = label;
      current = 0;
      score = 0;
      streak = 0;
      showScreen('play');
      renderQuestion();
    };

    game.querySelectorAll('[data-difficulty]').forEach((button) => {
      button.addEventListener('click', () => startGame(Number(button.dataset.difficulty), button.dataset.label || 'Znalec'));
    });

    optionsNode.addEventListener('click', (event) => selectAnswer(event.target.closest('.master-option')));

    nextButton.addEventListener('click', () => {
      if (current < activeQuestions.length - 1) {
        current += 1;
        renderQuestion();
      } else {
        finishGame();
      }
    });

    game.querySelector('[data-restart]').addEventListener('click', () => showScreen('start'));
    game.querySelector('[data-play-again]').addEventListener('click', () => showScreen('start'));

    game.querySelector('[data-share]').addEventListener('click', async () => {
      try {
        if (navigator.share) {
          await navigator.share({ title: 'Bylinkový mistr', text: lastShareText, url: window.location.href });
          shareStatus.textContent = 'Výsledek je připraven ke sdílení.';
        } else if (navigator.clipboard) {
          await navigator.clipboard.writeText(`${lastShareText} ${window.location.href}`);
          shareStatus.textContent = 'Výsledek byl zkopírován do schránky.';
        } else {
          shareStatus.textContent = lastShareText;
        }
      } catch (error) {
        if (error?.name !== 'AbortError') shareStatus.textContent = 'Sdílení se nepodařilo. Výsledek můžete zkopírovat ručně.';
      }
    });

    game.addEventListener('keydown', (event) => {
      if (playScreen.hidden || answered || !['1', '2', '3'].includes(event.key)) return;
      const button = optionsNode.querySelectorAll('.master-option')[Number(event.key) - 1];
      if (button) selectAnswer(button);
    });

    loadBest();
    showScreen('start');
  });
</script>

<style>
  .herb-master{position:relative;overflow:hidden;border:1px solid rgba(38,98,54,.2);border-radius:32px;background:linear-gradient(145deg,#fffef8 0%,#f4faef 58%,#e7f3df 100%);box-shadow:0 28px 70px rgba(35,76,42,.16)}
  .herb-master:before,.herb-master:after{content:"";position:absolute;border-radius:50%;pointer-events:none}.herb-master:before{width:300px;height:300px;right:-160px;top:-170px;background:rgba(105,157,80,.16)}.herb-master:after{width:220px;height:220px;left:-130px;bottom:-140px;background:rgba(216,166,58,.13)}
