      <g stroke="#2e6335" stroke-width="5" stroke-linecap="round">
        <path d="M94 349C89 297 76 257 54 224" fill="none" />
        <path d="M65 244C39 239 23 225 18 206C43 203 63 215 72 236Z" fill="#6c9c4e" />
        <path d="M80 286C52 285 34 274 25 255C51 248 73 259 86 279Z" fill="#83af62" />
        <path d="M547 348C555 299 570 259 594 226" fill="none" />
        <path d="M584 247C611 240 629 226 635 207C609 205 588 218 579 239Z" fill="#6c9c4e" />
        <path d="M566 288C594 285 614 273 624 253C597 248 574 260 560 281Z" fill="#83af62" />
      </g>
    </>
  )}

  {variant === 'deals' && (
    <>
      <rect width="640" height="420" rx="38" fill="#f2dfb6" />
      <path d="M0 336C141 303 273 329 385 345C485 360 562 346 640 316V420H0Z" fill="#d6b46e" opacity=".72" />
      <g transform="translate(114 155)" filter={`url(#${uid}-shadow)`}>
        <path d="M0 78H412L377 220H35Z" fill="#ba7a35" stroke="#5d421f" stroke-width="7" />
        <path d="M31 112H381M23 158H390" stroke="#edc17b" stroke-width="10" />
        {[50, 155, 260].map((x, index) => (
          <g transform={`translate(${x} ${index === 1 ? -22 : 0})`}>
            <path d="M18 0H91L84 126H25Z" fill={index === 1 ? '#b84b54' : '#f5c04c'} stroke="#315b34" stroke-width="6" />
            <rect x="28" y="-34" width="53" height="40" rx="8" fill="#e9a63a" stroke="#315b34" stroke-width="6" />
            <rect x="31" y="44" width="49" height="31" rx="7" fill="#fff1c7" opacity=".9" />
          </g>
        ))}
      </g>
      <g transform="translate(475 77)" rotate(12)" >
        <path d="M0 0H116V80H0Z" fill="#fff5d7" stroke="#8d5b25" stroke-width="6" />
        <circle cx="18" cy="18" r="7" fill="#8d5b25" />
        <path d="M34 26H91M28 49H83" stroke="#d99128" stroke-width="8" stroke-linecap="round" />
      </g>
    </>
  )}

  {variant === 'games' && (
    <>
      <rect width="640" height="420" rx="38" fill="#d7e7d5" />
      <circle cx="515" cy="85" r="67" fill="#f3c85c" opacity=".7" />
      <g transform="translate(115 83)" filter={`url(#${uid}-shadow)`}>
        <g transform="rotate(-8 110 136)">
          <rect x="0" y="20" width="170" height="230" rx="24" fill="#fff9e7" stroke="#315d35" stroke-width="7" />
          <path d="M83 192C83 126 91 87 113 54" fill="none" stroke="#2e6938" stroke-width="6" />
          <path d="M108 64C78 61 61 46 54 26C82 22 105 37 115 56Z" fill="#70a953" stroke="#2e6938" stroke-width="5" />
          <path d="M96 112C67 114 47 102 37 82C65 75 89 87 102 105Z" fill="#8cbf68" stroke="#2e6938" stroke-width="5" />
        </g>
        <g transform="translate(218 5) rotate(8 100 135)">
          <rect width="180" height="240" rx="24" fill="#f6dfaa" stroke="#674d27" stroke-width="7" />
          <circle cx="90" cy="103" r="48" fill="#e39831" />
          <path d="M52 168H128" stroke="#fff4cf" stroke-width="12" stroke-linecap="round" />
        </g>
      </g>
      <g transform="translate(469 263)" fill="#7b5ca3" stroke="#4d3d65" stroke-width="5">
        <path d="M0 24C0 11 11 0 24 0H52V28H80V56H52V84H24C11 84 0 73 0 60V52H28V32H0Z" />
      </g>
    </>
  )}

  {variant === 'timing' && (
    <>
      <rect width="640" height="420" rx="38" fill="#e7e9c5" />
      <circle cx="165" cy="108" r="63" fill="#f4c85a" />
      <path d="M478 56A70 70 0 1 0 531 164A57 57 0 1 1 478 56Z" fill="#765d9d" />
      <g transform="translate(194 112)" filter={`url(#${uid}-shadow)`}>
        <circle cx="126" cy="126" r="112" fill="#fff8df" stroke="#315d35" stroke-width="8" />
        <path d="M126 126V58M126 126L181 151" stroke="#315d35" stroke-width="10" stroke-linecap="round" />
        <circle cx="126" cy="126" r="12" fill="#e59a2c" />
      </g>
      <path d="M83 354C87 306 105 266 138 229" fill="none" stroke="#33703b" stroke-width="6" />
      <path d="M113 259C82 258 61 244 50 222C80 214 105 226 120 250Z" fill="#79ab58" stroke="#33703b" stroke-width="5" />
    </>
  )}

  {variant === 'identify' && (
    <>
      <rect width="640" height="420" rx="38" fill="#dbe8cc" />
      <g transform="translate(92 66)" filter={`url(#${uid}-shadow)`}>
        {[0, 1, 2].map((index) => (
          <g transform={`translate(${index * 152} ${index % 2 ? 28 : 0}) rotate(${index === 0 ? -6 : index === 2 ? 6 : 0} 70 140)`}>
            <rect width="132" height="280" rx="22" fill="#fff9e8" stroke="#315d35" stroke-width="7" />
            <path d="M66 214C66 147 72 104 86 64" fill="none" stroke="#2f6a38" stroke-width="6" />
            <path d="M83 78C52 76 35 59 29 38C58 36 81 51 91 70Z" fill={index === 1 ? '#7d5da5' : '#72aa51'} stroke="#2f6a38" stroke-width="5" />
            <path d="M75 126C48 130 29 119 18 100C44 92 68 103 82 119Z" fill={index === 2 ? '#d9a73e' : '#8fbd69'} stroke="#2f6a38" stroke-width="5" />
            <path d="M28 244H104" stroke="#c7b99b" stroke-width="10" stroke-linecap="round" />
          </g>
        ))}
      </g>
    </>
  )}

  {variant === 'ethics' && (
    <>
      <rect width="640" height="420" rx="38" fill="#e3ecd0" />
      <g transform="translate(115 70)" filter={`url(#${uid}-shadow)`}>
        <path d="M48 224C106 168 151 160 203 189C155 253 94 276 31 266Z" fill="#f2bf91" stroke="#7c4c2b" stroke-width="7" />
        <path d="M362 224C304 168 259 160 207 189C255 253 316 276 379 266Z" fill="#f2bf91" stroke="#7c4c2b" stroke-width="7" />
        <path d="M205 202C205 128 205 82 207 35" fill="none" stroke="#2f6838" stroke-width="8" />
        <path d="M205 86C157 84 129 59 118 25C162 20 199 45 216 77Z" fill="#6ea34f" stroke="#2f6838" stroke-width="7" />
        <path d="M207 138C251 132 285 149 306 181C265 199 229 180 204 148Z" fill="#87b764" stroke="#2f6838" stroke-width="7" />
      </g>
    </>
  )}

  {variant === 'avoid' && (
    <>
      <rect width="640" height="420" rx="38" fill="#f2ddc0" />
