        <path d="M73 97H230M64 135H238M58 174H230" stroke="#f6d48e" stroke-width="9" opacity=".8" />
      </g>
      <g stroke="#2e6335" stroke-width="5" stroke-linecap="round">
        <path d="M245 197C234 137 238 92 251 47" fill="none" />
        <path d="M250 74C215 69 197 53 190 31C222 28 248 44 258 66Z" fill="#5f9b49" />
        <path d="M249 120C217 120 198 106 188 86C216 78 243 91 255 112Z" fill="#77aa59" />
        <path d="M367 202C382 142 386 91 376 49" fill="none" />
        <path d="M378 80C407 70 432 77 450 95C423 111 397 104 378 88Z" fill="#6ca252" />
        <path d="M374 132C406 126 430 137 445 158C415 170 390 158 373 140Z" fill="#8ab967" />
      </g>
    </>
  )}

  {variant === 'recipes' && (
    <>
      <rect width="640" height="420" rx="38" fill="#f6e0b5" />
      <path d="M0 330C146 284 251 316 365 337C472 357 557 337 640 298V420H0Z" fill="#d7a957" opacity=".62" />
