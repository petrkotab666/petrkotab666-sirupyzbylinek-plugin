          <path d="M18 28C-6 23-18 8-20-9C3-9 19 3 25 22Z" fill="#6fa44e" />
          <path d="M24 60C1 60-13 47-18 31C5 26 21 38 29 54Z" fill="#83b15e" />
        </g>
      </g>
    </>
  )}

  {variant === 'magazine' && (
    <>
      <rect width="640" height="420" rx="38" fill="#e8dfef" />
      <circle cx="520" cy="80" r="64" fill="#d8b052" opacity=".72" />
      <g transform="translate(104 115)" filter={`url(#${uid}-shadow)`}>
        <path d="M16 38C104 8 170 15 216 54V238C159 207 92 207 16 235Z" fill="#fffaf0" stroke="#4f4764" stroke-width="7" />
        <path d="M416 38C328 8 262 15 216 54V238C273 207 340 207 416 235Z" fill="#fffaf0" stroke="#4f4764" stroke-width="7" />
        <path d="M216 54V238" stroke="#a88343" stroke-width="7" />
        <path d="M52 88H167M52 126H183M52 164H153M280 88H381M260 126H381M288 164H381" stroke="#b7a9bd" stroke-width="8" stroke-linecap="round" />
