        <ellipse cx="172" cy="224" rx="153" ry="29" fill="#8f5c31" opacity=".25" />
        <path d="M34 97H300L272 225H64Z" fill="#f7b13f" stroke="#74491f" stroke-width="7" />
        <path d="M16 84H318" stroke="#74491f" stroke-width="18" stroke-linecap="round" />
        <path d="M73 86C84 27 250 27 260 86" fill="none" stroke="#74491f" stroke-width="8" />
        <path d="M130 32C138 8 165-2 184 9C201 19 208 38 204 61" fill="none" stroke="#366b36" stroke-width="7" />
        <path d="M173 14C149 2 126 7 111 23C132 39 156 36 176 22Z" fill="#6ca34d" stroke="#366b36" stroke-width="5" />
      </g>
      <g transform="translate(420 134)" filter={`url(#${uid}-shadow)`}>
        <path d="M25 34H111L104 203H32Z" fill="#fff8e5" stroke="#74491f" stroke-width="6" />
