        <path d="M53 138C57 86 52 42 38 0" fill="none" />
        <path d="M40 32C14 27 0 13-5-6C20-7 38 7 46 25Z" fill="#6ea34f" />
        <path d="M47 76C18 75 1 62-7 43C21 37 42 49 53 68Z" fill="#80b05e" />
      </g>
      <path d="M77 344L563 77" stroke="#a33b3f" stroke-width="20" stroke-linecap="round" opacity=".9" />
    </>
  )}

  {variant === 'places' && (
    <>
      <rect width="640" height="420" rx="38" fill="#d9e8ca" />
      <circle cx="510" cy="79" r="61" fill="#f3c75a" />
