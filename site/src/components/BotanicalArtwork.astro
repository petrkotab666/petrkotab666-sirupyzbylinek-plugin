---
interface Props {
  variant?: 'hero' | 'harvest' | 'recipes' | 'pharmacy' | 'magazine' | 'deals' | 'games' | 'timing' | 'identify' | 'ethics' | 'avoid' | 'places' | 'process';
  class?: string;
}

const { variant = 'hero', class: className = '' } = Astro.props;
const uid = `botanical-${variant}-${Math.random().toString(36).slice(2, 8)}`;
---
<svg
  class:list={['botanical-artwork', `botanical-artwork--${variant}`, className]}
  viewBox="0 0 640 420"
  role="img"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${uid}-cream`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fff8df" />
      <stop offset="1" stop-color="#e8efcf" />
    </linearGradient>
    <linearGradient id={`${uid}-green`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6e9e4f" />
      <stop offset="1" stop-color="#285d34" />
    </linearGradient>
    <linearGradient id={`${uid}-amber`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffd15c" />
      <stop offset="1" stop-color="#e68a1f" />
    </linearGradient>
    <filter id={`${uid}-shadow`} x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="10" stdDeviation="10" flood-color="#17391f" flood-opacity=".18" />
    </filter>
  </defs>

  {variant === 'hero' && (
    <>
      <rect width="640" height="420" rx="42" fill={`url(#${uid}-cream)`} />
      <circle cx="520" cy="78" r="72" fill="#f5c75c" opacity=".72" />
      <path d="M0 330C102 278 188 305 281 340C378 376 491 357 640 292V420H0Z" fill="#cfe0aa" />
      <path d="M0 365C111 321 207 344 302 376C405 410 510 388 640 340V420H0Z" fill="#8eb56d" opacity=".9" />
      <g stroke="#245a31" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M92 315C88 246 103 179 142 105" fill="none" />
        <path d="M139 111C108 106 88 89 78 65C113 64 139 81 150 103Z" fill="#76a755" />
        <path d="M121 158C88 160 65 145 51 121C86 113 116 128 130 151Z" fill="#5d9447" />
        <path d="M111 211C78 220 51 211 31 191C62 174 96 184 118 204Z" fill="#78aa58" />
        <path d="M101 264C72 278 44 276 20 260C47 237 83 241 108 256Z" fill="#5d9348" />
      </g>
      <g transform="translate(210 134)" filter={`url(#${uid}-shadow)`}>
        <path d="M26 28H94L86 63V198C86 216 74 228 60 228S34 216 34 198V63Z" fill="#fff8e5" stroke="#23542f" stroke-width="6" />
        <rect x="38" y="78" width="44" height="132" rx="20" fill={`url(#${uid}-amber)`} />
        <rect x="42" y="0" width="36" height="35" rx="9" fill="#d99027" stroke="#23542f" stroke-width="6" />
        <path d="M40 121H80" stroke="#fff3b0" stroke-width="7" stroke-linecap="round" opacity=".8" />
      </g>
      <g transform="translate(342 177)" filter={`url(#${uid}-shadow)`}>
        <path d="M12 38H126L116 175H22Z" fill="#fff8e5" stroke="#23542f" stroke-width="6" stroke-linejoin="round" />
        <path d="M26 61H112L103 158H35Z" fill="#b64048" opacity=".88" />
        <rect x="4" y="16" width="130" height="34" rx="12" fill="#e7a52e" stroke="#23542f" stroke-width="6" />
        <path d="M52 10C52-3 61-14 69-14S86-3 86 10" fill="none" stroke="#23542f" stroke-width="6" />
      </g>
      <g transform="translate(485 183)" stroke="#285d34" stroke-width="5" stroke-linecap="round">
        <path d="M52 156C57 99 51 52 38 0" fill="none" />
        <path d="M40 30C12 22 3 5 1-13C27-12 43 4 47 24Z" fill="#6da04f" />
