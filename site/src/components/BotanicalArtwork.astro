        <rect x="39" y="0" width="57" height="41" rx="9" fill="#e59b2d" stroke="#74491f" stroke-width="6" />
      </g>
    </>
  )}

  {variant === 'pharmacy' && (
    <>
      <rect width="640" height="420" rx="38" fill="#d9ead2" />
