        <rect width="442" height="302" rx="28" fill="#f3ead4" stroke="#245630" stroke-width="7" />
        <path d="M221 0V302M0 145H442" stroke="#8b6843" stroke-width="7" />
        {[52, 146, 268, 362].map((x, index) => (
