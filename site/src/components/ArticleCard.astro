---
import ArticleImage from './ArticleImage.astro';
import { cleanDescription, type ArticleEntry } from '../lib/articles';

interface Props { entry: ArticleEntry }
const { entry } = Astro.props;
const { title, path, category, date } = entry.data;
const description = cleanDescription(entry.data.description, entry.body);
---
<article class="article-card">
  <a class="card-image" href={path} aria-label={title}>
    <ArticleImage entry={entry} decorative={true} />
  </a>
  <div class="card-body">
    <div class="card-meta"><span>{category}</span>{date && <time datetime={date.toISOString()}>{date.toLocaleDateString('cs-CZ')}</time>}</div>
    <h2><a href={path}>{title}</a></h2>
    <p>{description}</p>
    <a class="text-link" href={path}>Číst dál <span aria-hidden="true">→</span></a>
  </div>
</article>
