---
import type { ArticleEntry } from '../lib/articles';
import { topicKey } from '../lib/articles';

interface Props {
  entry?: ArticleEntry;
  topic?: string;
  heading?: string;
  placement?: 'primary' | 'secondary';
}

const {
  entry,
  topic: topicOverride,
  heading = 'Co se může hodit k tomuto tématu',
  placement = 'primary',
} = Astro.props;
const topic = topicOverride || (entry ? topicKey(entry) : 'bylinky');

const campaigns = {
  bylik: {
    icon: '🌿',
    title: 'Sušené bylinky, koření a plody',
    text: 'Suroviny pro čaje, sirupy, tinktury i domácí směsi.',
    href: 'https://ehub.cz/system/scripts/click.php?a_aid=6926a50f&a_bid=55880a67',
    cta: 'Prohlédnout nabídku',
  },
  sklo: {
    icon: '🫙',
    title: 'Lahve, sklenice a víčka',
    text: 'Vybavení pro sirupy, zavařování, med, džemy a domácí výrobu.',
    href: 'https://ehub.cz/system/scripts/click.php?a_aid=6926a50f&a_bid=4f262bbb',
    cta: 'Vybrat sklenice',
  },
  knihy: {
    icon: '📚',
    title: 'Knihy o bylinkách a domácích receptech',
    text: 'Atlasy, receptáře a praktické příručky pro začátečníky i zkušené.',
    href: 'https://ehub.cz/system/scripts/click.php?a_aid=6926a50f&a_bid=1ec2df65',
    cta: 'Najít vhodnou knihu',
  },
  brainmax: {
    icon: '🧬',
    title: 'Výživa, vitaminy a minerály',
    text: 'Doplňky pro běžnou výživu, regeneraci a aktivní životní styl.',
    href: 'https://ehub.cz/system/scripts/click.php?a_aid=6926a50f&a_bid=e9a1924a',
    cta: 'Zobrazit nabídku',
  },
  econea: {
    icon: '🦟',
    title: 'Ochrana proti komárům a klíšťatům',
    text: 'Repelenty, ochranné spreje a přípravky do přírody.',
    href: 'https://www.econea.cz/collections/produkty-do-prirody-proti-hmyzu?a_box=se8pw4uc',
    cta: 'Vybrat ochranu do přírody',
  },
  drpopov: {
    icon: '💧',
    title: 'Bylinné kapky a tradiční přípravky',
    text: 'Výběr bylinných kapek, čajů, mastí a dalších hotových přípravků.',
    href: 'https://ehub.cz/system/scripts/click.php?a_aid=6926a50f&a_bid=4e3651a5',
    cta: 'Prohlédnout bylinné přípravky',
  },
  nadeje: {
    icon: '🌱',
    title: 'Bylinné výtažky a přírodní péče',
    text: 'Hotové bylinné produkty a výtažky pro ty, kdo nechtějí vyrábět doma.',
    href: 'https://ehub.cz/system/scripts/click.php?a_aid=6926a50f&a_bid=4f361f12',
    cta: 'Zobrazit nabídku',
  },
  vivaco: {
    icon: '🧴',
    title: 'Přírodní kosmetika a domácí péče',
    text: 'Kosmetika, bylinné balzámy a další produkty pro zevní péči.',
    href: 'https://ehub.cz/system/scripts/click.php?a_aid=6926a50f&a_bid=759c16de',
    cta: 'Vybrat přírodní péči',
  },
  naturprodukt: {
    icon: '🍃',
    title: 'Přírodní produkty a bylinná inspirace',
    text: 'Další výběr bylinných produktů, čajů a přírodní domácí péče.',
    href: 'https://ehub.cz/system/scripts/click.php?a_aid=6926a50f&a_bid=d72003c9',
    cta: 'Otevřít nabídku',
  },
};

type CampaignKey = keyof typeof campaigns;

const primaryByTopic: Record<string, CampaignKey[]> = {
  recepty: ['sklo', 'bylik', 'knihy'],
  napoje: ['sklo', 'bylik', 'knihy'],
  zavarovani: ['sklo', 'knihy', 'bylik'],
  sber: ['bylik', 'knihy', 'sklo'],
  pestovani: ['bylik', 'knihy', 'sklo'],
  zdravi: ['brainmax', 'bylik', 'knihy'],
  vyziva: ['brainmax', 'bylik', 'knihy'],
  krasa: ['vivaco', 'bylik', 'knihy'],
  zvirata: ['bylik', 'knihy', 'sklo'],
  repelenty: ['econea', 'bylik', 'knihy'],
  bylinky: ['bylik', 'knihy', 'sklo'],
};

const secondaryByTopic: Record<string, CampaignKey[]> = {
  recepty: ['drpopov', 'nadeje', 'naturprodukt'],
  napoje: ['naturprodukt', 'drpopov', 'nadeje'],
  zavarovani: ['naturprodukt', 'drpopov', 'vivaco'],
  sber: ['drpopov', 'nadeje', 'naturprodukt'],
  pestovani: ['nadeje', 'naturprodukt', 'drpopov'],
  zdravi: ['drpopov', 'nadeje', 'naturprodukt'],
  vyziva: ['naturprodukt', 'drpopov', 'nadeje'],
  krasa: ['vivaco', 'drpopov', 'naturprodukt'],
  zvirata: ['naturprodukt', 'drpopov', 'nadeje'],
  repelenty: ['vivaco', 'naturprodukt', 'drpopov'],
  bylinky: ['drpopov', 'nadeje', 'naturprodukt'],
};

const selectedKeys = placement === 'secondary'
  ? (secondaryByTopic[topic] || secondaryByTopic.bylinky)
  : (primaryByTopic[topic] || primaryByTopic.bylinky);
const selected = selectedKeys.map((key) => campaigns[key]);
---
<aside class:list={['context-ads', `context-ads--${placement}`]} data-ad-placement={placement} aria-label="Tematické komerční nabídky">
  <div class="ad-heading">
    <span>Reklama</span>
    <strong>{heading}</strong>
  </div>
  <div class="context-ad-grid">
    {selected.map((campaign) => (
      <a class="context-ad-card" href={campaign.href} target="_blank" rel="nofollow sponsored noopener noreferrer">
        <span class="context-ad-icon" aria-hidden="true">{campaign.icon}</span>
        <span class="context-ad-copy"><strong>{campaign.title}</strong><small>{campaign.text}</small></span>
        <span class="context-ad-cta">{campaign.cta} →</span>
      </a>
    ))}
  </div>
  <p class="ad-disclosure">Za nákup přes označený odkaz může provozovatel získat provizi. Cena pro čtenáře se tím nemění.</p>
</aside>
