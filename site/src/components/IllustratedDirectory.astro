---
import BotanicalArtwork from './BotanicalArtwork.astro';

interface DirectoryItem {
  href: string;
  title: string;
  text: string;
  art: 'harvest' | 'recipes' | 'pharmacy' | 'magazine' | 'deals' | 'games' | 'timing' | 'identify' | 'ethics' | 'avoid' | 'places' | 'process';
  kicker?: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  items: DirectoryItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---
<div class:list={['illustrated-directory', className]}>
  {items.map((item, index) => (
    <a class:list={['illustrated-directory-card', item.image && 'illustrated-directory-card--photo']} href={item.href}>
      <span class="illustrated-directory-art" aria-hidden={!item.image ? 'true' : undefined}>
        {item.image ? (
          <img
            src={item.image}
            alt={item.imageAlt || ''}
            width="1024"
            height="576"
            loading={index < 8 ? 'eager' : 'lazy'}
            fetchpriority={index < 4 ? 'high' : 'auto'}
            decoding="async"
          />
        ) : (
          <BotanicalArtwork variant={item.art} />
        )}
      </span>
      <span class="illustrated-directory-shade" aria-hidden="true"></span>
      <span class="illustrated-directory-copy">
        {item.kicker && <small>{item.kicker}</small>}
        <strong>{item.title}</strong>
        <span>{item.text}</span>
        <b>Otevřít <span aria-hidden="true">→</span></b>
      </span>
    </a>
  ))}
</div>