---
import { hubPhotoAlt, resolveHubImage, uniqueHubPhoto } from '../lib/hub-photo';

interface DirectoryItem {
  href: string;
  title: string;
  text: string;
  art: 'harvest' | 'recipes' | 'pharmacy' | 'magazine' | 'deals' | 'games' | 'timing' | 'identify' | 'ethics' | 'avoid' | 'places' | 'process';
  kicker?: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  items: DirectoryItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
const group = Astro.url.pathname;
const usedImages = new Set<string>();
const resolvedItems = items.map((item, index) => {
  let image = resolveHubImage(item.image || '', item.href, item.title, index, group);
  if (usedImages.has(image)) image = uniqueHubPhoto(usedImages, item.href, item.title, index, group);
  usedImages.add(image);
  return {
    ...item,
    image,
    imageAlt: item.imageAlt || hubPhotoAlt(item.title),
  };
});
---
<div class:list={['illustrated-directory', className]}>
  {resolvedItems.map((item) => (
    <a class="illustrated-directory-card illustrated-directory-card--photo" href={item.href}>
      <span class="illustrated-directory-art">
        <img
          src={item.image}
          alt={item.imageAlt || hubPhotoAlt(item.title)}
          width="1024"
          height="576"
          loading="lazy"
          decoding="async"
        />
      </span>
      <span class="illustrated-directory-shade" aria-hidden="true"></span>
      <span class="illustrated-directory-copy">
        {item.kicker && <small>{item.kicker}</small>}
        <strong>{item.title}</strong>
        <span>{item.text}</span>
        <b>Otevřít <span aria-hidden="true">→</span></b>
      </span>
    </a>
  ))}
</div>
