---
const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Úvod' },
  { href: '/domu/sber-bylinek/', label: 'Sběr bylinek' },
  { href: '/magazin/', label: 'Magazín' },
  { href: '/bylinkova-herna/', label: 'Herna' },
  { href: '/osvedcene-recepty/', label: 'Recepty' },
  { href: '/domu/prirodni-lekarna/', label: 'Přírodní lékárna' },
  { href: '/aktualni-slevy-a-vyhodne-nabidky-pro-bylinkare/', label: 'Slevy' },
];
const active = (href) => href === '/' ? pathname === '/' : pathname.startsWith(href);
const originalLogo = '/media/imported/prirodni-repelenty-proti-komarum-a-klistatum/sirupyzbylineklogo1-1-53a25adc.png';
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand brand--original" href="/" aria-label="Sirupy z bylinek – domů">
      <img
        class="brand-original-logo"
        src={originalLogo}
        alt="Sirupy z bylinek"
        width="525"
        height="476"
        decoding="async"
      />
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-menu">
      <span class="sr-only">Otevřít menu</span><span aria-hidden="true">☰</span>
    </button>
    <nav id="main-menu" class="main-menu" aria-label="Hlavní navigace">
      {links.map((link) => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
    </nav>
  </div>
</header>
<script is:inline>
  const button = document.querySelector('.menu-button');
  const menu = document.querySelector('#main-menu');
  if (button && menu) {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!open));
      menu.classList.toggle('is-open', !open);
    });
  }
</script>
